<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file build for the Inno Setup installer
  (packaging/windows-installer/TgPoolLauncher.iss), matching apps/desktop's
  own win-x64 profile: this exe is the license-activation gate that runs
  before TgPoolLauncher.exe's main window, so it needs the same no-.NET-required
  packaging.

  Build: dotnet publish -c Release -p:PublishProfile=win-x64
  Output: bin\Release\net10.0-windows\win-x64\publish\TgPoolActivator.exe
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
