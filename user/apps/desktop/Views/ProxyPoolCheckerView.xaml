<UserControl x:Class="TgPoolLauncher.Views.ProxyPoolCheckerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980">
    <UserControl.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="PlaceholderFieldStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="InfoTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style x:Key="ResultTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="ResultValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" MaxWidth="700" HorizontalAlignment="Left">

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{tr:Tr Common.SettingsHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                        <Button Grid.Column="1" Command="{Binding ResetFormCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Restore" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{tr:Tr Common.Reset}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,16,16">
                                    <TextBlock Text="{tr:Tr Rotation.ModeLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox SelectedIndex="{Binding RotationModeIndex}">
                                        <ComboBoxItem Content="{tr:Tr Rotation.ModeRotating}" />
                                        <ComboBoxItem Content="{tr:Tr Rotation.ModeSticky}" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{tr:Tr Rotation.ProtocolLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox SelectedIndex="{Binding RotationProtocolIndex}">
                                        <ComboBoxItem Content="{tr:Tr Rotation.ProtocolHttp}" />
                                        <ComboBoxItem Content="{tr:Tr Rotation.ProtocolSocks5}" />
                                    </ComboBox>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,16,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStickyMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{tr:Tr Rotation.ProxyListLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <TextBox Text="{Binding RotationProxyText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="ip:port:login:pass"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextFaintBrush}"
                                                   FontSize="13"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding RotationProxyText, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStickyMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{tr:Tr Rotation.RequestCountLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding RotationRequestCount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Margin="0,0,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStickyMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{tr:Tr Rotation.StickyProxyListLabel}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding RotationProxyText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="118" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{tr:Tr Common.ResultsHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="0,16,0,14" />
                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource ResultTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="24" Height="24" CornerRadius="12"
                                                Background="{StaticResource SuccessTintBrush}" Margin="0,0,8,0">
                                            <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="14" Height="14"
                                                                       Foreground="{StaticResource SuccessBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{tr:Tr Rotation.UniqueLabel}" Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding RotationUniqueCount, Mode=OneWay}" Style="{StaticResource ResultValueStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource ResultTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="24" Height="24" CornerRadius="12"
                                                Background="{StaticResource WarningTintBrush}" Margin="0,0,8,0">
                                            <iconPacks:PackIconMaterial Kind="ContentDuplicate" Width="14" Height="14"
                                                                       Foreground="{StaticResource WarningBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{tr:Tr Rotation.DuplicatesLabel}" Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding RotationDuplicateCount, Mode=OneWay}" Style="{StaticResource ResultValueStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource ResultTileStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="24" Height="24" CornerRadius="12"
                                                Background="{StaticResource DangerTintBrush}" Margin="0,0,8,0">
                                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="14" Height="14"
                                                                       Foreground="{StaticResource DangerBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{tr:Tr Rotation.ErrorsLabel}" Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding RotationErrorCount, Mode=OneWay}" Style="{StaticResource ResultValueStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ProgressBar IsIndeterminate="True" Margin="0,16,0,0"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Invert}" />

                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,22,0,0" Width="220"
                            HorizontalAlignment="Center" Command="{Binding StartCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{tr:Tr Common.Start}" VerticalAlignment="Center" />
                            <iconPacks:PackIconMaterial Kind="PlayCircleOutline" Width="15" Height="15" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Text="{tr:Tr Rotation.ImportantHeader}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SectionCardStyle}" Background="{StaticResource AccentTintBrush}" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="{tr:Tr Rotation.ImportantUnique}" Style="{StaticResource InfoTextStyle}" />
                    <TextBlock Text="{tr:Tr Rotation.ImportantSticky}" Style="{StaticResource InfoTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{tr:Tr Rotation.ImportantBackend}" Style="{StaticResource InfoTextStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
