<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces, darkest to lightest -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C0C0E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#17171A" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1F1F23" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#28282D" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2F" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#38383F" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#6B7280" />

    <!-- Accent (blue) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#2A3B82F6" />
    <SolidColorBrush x:Key="SelectionTintBrush" Color="#2A3B82F6" />

    <!-- Status accents (also used by DashboardView's stat tiles) -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#2416A34A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="#24EF4444" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="#24F59E0B" />

    <!-- Liquid-glass surfaces: semi-transparent gradients standing in for real
         backdrop blur (WPF has no live blur-behind), used by empty placeholder
         cards on the Dashboard. -->
    <LinearGradientBrush x:Key="GlassBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="0.55" />
        <GradientStop Color="#04FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#22FFFFFF" />
    <LinearGradientBrush x:Key="GlassAccentBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#333B82F6" Offset="0" />
        <GradientStop Color="#0F3B82F6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassAccentBorderBrush" Color="#4D3B82F6" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="#16FFFFFF" />

    <!-- Sidebar surface: a faint glass sheen layered over SurfaceBrush, and the
         blue-to-violet gradient used for the active nav pill / accents. -->
    <LinearGradientBrush x:Key="SidebarGlassBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#06FFFFFF" Offset="0.4" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavActiveGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NavGlowBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="LicenseHealthyBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="LicenseWarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="LicenseDangerBrush" Color="#F87171" />

    <!-- Soften the native selection chrome on every DataGrid app-wide -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2A3B82F6" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F4F4F5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2A3B82F6" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2A3B82F6" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F4F4F5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#17171A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F4F4F5" />

</ResourceDictionary>
