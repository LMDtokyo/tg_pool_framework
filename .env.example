# ================================================================
# .env.example — Шаблон конфигурации tg_pool_framework
# Скопируй в .env и заполни нужные поля.
# НИКОГДА НЕ КОММИТЬ .env В РЕПОЗИТОРИЙ!
# ================================================================

# ---------------------------------------------------------------
# РЕЖИМ РАБОТЫ — каждый режим независим, со своими настройками ниже.
# send            — рассылка сообщений (кампания)
# parse           — сбор пользователей (парсинг)
# check_accounts  — проверка здоровья аккаунтов
# check_proxies   — проверка прокси
# convert_tdata   — конвертация tdata → session
# convert_session — конвертация session → tdata
#
# Если оставить пустым и запускать интерактивно (в терминале) — появится
# меню выбора. В Docker/cron без интерактивного терминала MODE обязателен.
# ---------------------------------------------------------------
MODE=send


# ================================================================
# ОБЩЕЕ — используется несколькими режимами (загрузка аккаунтов и т.п.)
# ================================================================

# Папка для лог-файла (backend.log, ротация 5x5МБ). Пусто — только stdout.
# WPF-лаунчер передаёт сюда свою Data\Logs автоматически, менять не нужно.
LOG_DIR=

# ---------------------------------------------------------------
# СПОСОБ 1: Директория с .session + .json парами (рекомендуется)
# Каждый аккаунт = файл phone.session + phone.json
# JSON-формат: {"app_id": 1234, "app_hash": "...", "phone": "+7..."}
# ---------------------------------------------------------------
ACCOUNTS_DIR=accounts/

# Резервные аккаунты для автоматического failover при бане воркера
SPARE_ACCOUNTS_DIR=accounts_spare/

# Если .json нет рядом с .session — используй глобальные api_id/api_hash
TG_API_ID_DEFAULT=0
TG_API_HASH_DEFAULT=

# Device/client fingerprint table used by Hero SMS Telegram authorization.
# Supported formats: .xlsx/.xlsm, .csv, or .json. The launcher defaults this
# to Data/Fingerprints/telegram_devices.xlsx.
TELEGRAM_FINGERPRINT_FILE=Data/Fingerprints/telegram_devices.xlsx

# ---------------------------------------------------------------
# СПОСОБ 3: Папки tdata (Telegram Desktop), опционально
# Ищутся рекурсивно на любой глубине под TDATA_ACCOUNTS_DIR.
# Каждая папка конвертируется в .session с сохранением исходного
# api_id/api_hash/device fingerprint (не банит аккаунт подменой identity).
# TDATA_PASSWORDS_FILE — JSON {"путь/к/tdata": "пароль_2FA"}, опционально.
# ---------------------------------------------------------------
TDATA_ACCOUNTS_DIR=
TDATA_PASSWORDS_FILE=


# ---------------------------------------------------------------
# СПОСОБ 2: Аккаунты через переменные окружения (до 49 штук)
# Используется если ACCOUNTS_DIR не задан или не существует.
# ---------------------------------------------------------------
TG_API_ID_1=12345678
TG_API_HASH_1=0123456789abcdef0123456789abcdef
TG_PHONE_1=+79001234567
TG_DEVICE_1=Samsung Galaxy S23
TG_SYSVER_1=Android 14

TG_API_ID_2=87654321
TG_API_HASH_2=fedcba9876543210fedcba9876543210
TG_PHONE_2=+79007654321
TG_DEVICE_2=iPhone 15 Pro
TG_SYSVER_2=iOS 17.4

# (добавляй TG_API_ID_3, TG_API_ID_4, ... до 49)


# ---------------------------------------------------------------
# ПРОКСИ (SOCKS5) — нумерация соответствует аккаунтам
# При использовании ACCOUNTS_DIR: proxy_N назначается через
# ACCOUNTS_PER_PROXY (сколько аккаунтов на один прокси).
# ---------------------------------------------------------------
PROXY_HOST_1=proxy1.example.com
PROXY_PORT_1=1080
PROXY_USER_1=user
PROXY_PASS_1=pass

PROXY_HOST_2=proxy2.example.com
PROXY_PORT_2=1080
PROXY_USER_2=user2
PROXY_PASS_2=pass2

# Сколько аккаунтов из ACCOUNTS_DIR получат один прокси (Round-Robin)
ACCOUNTS_PER_PROXY=1

# Проверка прокси аккаунтов перед стартом (режимы send и parse) — не
# дожидаться, пока Phase 0 упрётся в мёртвый прокси на каждом аккаунте.
# STRICT=1 — исключить аккаунты с мёртвым прокси из запуска, а не только
# предупредить о них в логе.
PROXY_PREFLIGHT_CHECK_ENABLED=0
PROXY_PREFLIGHT_STRICT=0


# ---------------------------------------------------------------
# Директория для хранения .session файлов (способ 2)
# ---------------------------------------------------------------
SESSION_DIR=sessions

# ---------------------------------------------------------------
# Шифрование .session файлов at rest (опционально)
# .session — это фактически bearer-токен авторизации в Telegram; при
# включении ClientPool расшифровывает файл перед connect() и шифрует
# обратно после disconnect(), так что plaintext лежит на диске только
# пока процесс реально его использует.
# Сгенерировать ключ:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Хранить ключ вне репозитория — через секрет-менеджер (Vault/SOPS) в проде.
# ---------------------------------------------------------------
SESSION_ENCRYPTION_ENABLED=0
SESSION_ENCRYPTION_KEY=

# ---------------------------------------------------------------
# PostgreSQL (персистентность состояния аккаунтов — опционально)
# Пусто — реестр аккаунтов работает только в памяти.
# ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tg_pool

# ---------------------------------------------------------------
# Отладка
# ---------------------------------------------------------------
# 1 — включить verbose-логирование
DEBUG=0


# ================================================================
# MODE=send — Рассылка сообщений
# ================================================================

# Цель: группа/канал, откуда берутся получатели
# Форматы: @username | https://t.me/+invite_hash | числовой ID
TG_TARGET_ENTITY=@python

# Ограничить рассылку аккаунтами из конкретной папки (см. /accounts/{phone}/folder).
# Пусто — используются все загруженные основные аккаунты.
CAMPAIGN_ACCOUNT_FOLDER=

# Сколько сообщений отправлять с одного аккаунта — случайное значение из
# диапазона [MIN, MAX]. MAX пусто — без ограничения (текущее поведение,
# аккаунт работает, пока не кончится очередь получателей).
CAMPAIGN_MESSAGES_PER_ACCOUNT_MIN=1
CAMPAIGN_MESSAGES_PER_ACCOUNT_MAX=

# Точное общее количество успешных отправок за всю кампанию. Пусто — кампания
# просто проходит по получателям один раз (текущее поведение). Если задано,
# кампания повторяется циклами (каждый раз исключая уже успешно отправленных
# получателей), пока не будет достигнуто нужное количество или пока источник
# не иссякнет (цикл не находит новых получателей).
CAMPAIGN_EXACT_TOTAL_TARGET=

# ---------------------------------------------------------------
# Сообщение
# Доступные плейсхолдеры (заполняются из данных получателя):
#   {first_name} {last_name} {username}
# Опечатка в плейсхолдере не ломает отправку — останется как есть.
# Поддерживается спинтакс {вариант1|вариант2|вариант3} — на каждого
# получателя случайно выбирается один из вариантов, вложенность разрешена.
# ---------------------------------------------------------------
TG_MESSAGE=Привет, {first_name}! 👋

# Поддерживается markdown (по умолчанию) или html
TG_PARSE_MODE=markdown

# Путь к медиафайлу (фото/видео/документ). Пусто — только текст.
# Игнорируется, если задан TG_MEDIA_PATHS.
TG_MEDIA_PATH=

# Список медиафайлов через запятую — на каждого получателя случайно
# выбирается один. Пусто — используется TG_MEDIA_PATH (один файл).
TG_MEDIA_PATHS=

# auto (обычный документ/фото/видео) | video_note (кружочек) | voice (голосовое, обычно .ogg)
TG_MEDIA_KIND=auto

# Кнопки под сообщением в формате: [Текст | https://url]
# Несколько кнопок в строке: [A | https://a.com] [B | https://b.com]
# Несколько строк — через \n в значении:
TG_BUTTONS=

# 1 — отправка без звука/всплывающего уведомления у получателя
TG_SILENT=0

# 0 — отключить предпросмотр ссылки в тексте сообщения (по умолчанию включён)
TG_LINK_PREVIEW=1

# ---------------------------------------------------------------
# Репост существующего сообщения вместо (или вместе с) обычной отправки.
# TG_FORWARD_LINK имеет приоритет; если не задан или не распознан —
# используется пара TG_BOT_RELAY_USERNAME + TG_BOT_RELAY_MESSAGE_IDS.
# ---------------------------------------------------------------
# Ссылка на пост: t.me/name/123 (публичный) или t.me/c/internal_id/123 (приватный)
TG_FORWARD_LINK=

# Юзернейм бота/канала-источника (например, тот же @Postbot) + список ID
# постов через запятую — на каждого получателя случайно выбирается один ID
TG_BOT_RELAY_USERNAME=
TG_BOT_RELAY_MESSAGE_IDS=

# ---------------------------------------------------------------
# Отложенная отправка, закреп, темп запуска воркеров, повтор кампании
# ---------------------------------------------------------------
# Дата/время (ISO 8601, например 2026-07-15T09:00:00+03:00) — если задано,
# каждое сообщение отправляется через Telegram-планировщик на этот момент
# вместо немедленной отправки (успех = "принято в очередь", а не "доставлено").
# Пусто — отправка сразу же (текущее поведение).
TG_SCHEDULE_AT=

# 1 — закрепить только что отправленное (или запланированное) сообщение
# в чате с получателем. Ошибка закрепления не отменяет успешную отправку.
TG_PIN_AFTER_SEND=0

# Запускать воркеров-отправителей группами по N штук вместо всех сразу,
# с паузой между группами — вместо резкого одновременного старта всего пула.
# Пусто — все воркеры стартуют одновременно (текущее поведение).
CAMPAIGN_WORKER_BATCH_SIZE=
CAMPAIGN_WORKER_BATCH_DELAY_SEC=0

# Через сколько часов после завершения кампании запускать её заново
# (тем же таргетом и настройками). Пусто — кампания выполняется один раз.
CAMPAIGN_REPEAT_EVERY_HOURS=

# ---------------------------------------------------------------
# Проверка здоровья аккаунтов перед запуском (preflight) и во время
# рассылки (фоновые проверки).
# ---------------------------------------------------------------
# 1 — включить pre-flight health check
HEALTH_CHECK_ENABLED=0
# 1 — дополнительно опросить @SpamBot (медленнее, но точнее)
HEALTH_DEEP_CHECK=0
# Параллельность health check
HEALTH_CONCURRENCY=5

# Автоматический возврат аккаунтов в пул по истечении restriction_expires
# (требует DATABASE_URL или хотя бы HEALTH_CHECK_ENABLED=1, чтобы реестр
# реально наполнялся статусами).
COOLDOWN_SCHEDULER_ENABLED=0
COOLDOWN_POLL_INTERVAL_SEC=60

# Периодическая перепроверка ВСЕГО пула во время рассылки (не только уже
# ограниченных аккаунтов) — ловит свежий бан/спамблок у аккаунта, который
# сейчас числится ALIVE. По умолчанию раз в 30 минут.
PERIODIC_HEALTH_CHECK_ENABLED=0
PERIODIC_HEALTH_CHECK_INTERVAL_SEC=1800

# ---------------------------------------------------------------
# Redis (распределённый Token Bucket + чёрный список)
# Отключи если Redis не нужен — оставь пустым.
# ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Токенов в секунду на весь пул (глобальный Rate Limit)
RATE_LIMIT_TOKENS_PER_SEC=1.0

# Максимальный burst (накопленные токены при простое)
RATE_LIMIT_BURST=5

# Поведение при отказе Redis: "open" — пропускать отправку (доступность важнее
# лимита), "closed" — блокировать отправку до восстановления Redis (безопаснее,
# но пайплайн встанет при недоступном Redis).
RATE_LIMIT_FAIL_MODE=open

# ---------------------------------------------------------------
# Warm-up новых аккаунтов — постепенный разгон вместо полной интенсивности
# с первого дня. Возраст аккаунта берётся из первой регистрации в реестре
# (переживает рестарты, если включена персистентность через DATABASE_URL).
# Дневной лимит сообщений на аккаунт требует REDIS_URL.
# ---------------------------------------------------------------
WARMUP_ENABLED=0
WARMUP_DURATION_DAYS=7
WARMUP_MIN_MULTIPLIER=3.0
WARMUP_MAX_DAILY_DAY0=10
WARMUP_MAX_DAILY_FULL=200

# ---------------------------------------------------------------
# Автоответчик на входящие (Lua-правила, hot-reload без перезапуска).
# Слушает входящие, пока аккаунты подключены для текущей рассылки —
# отдельного "только слушать" режима нет.
# Скрипт: scripts/auto_reply/auto_reply.lua
#   return function(message) return "текст ответа" end   -- или nil, чтобы промолчать
# message: {text, sender_id, sender_username, is_private}
# ---------------------------------------------------------------
AUTO_REPLY_ENABLED=0
AUTO_REPLY_SCRIPTS_DIR=scripts/auto_reply

# ---------------------------------------------------------------
# Временны́е задержки (секунды, дробные допустимы)
# ---------------------------------------------------------------
DELAY_BASE=2.0
DELAY_JITTER=1.5
MSG_DELAY=3.0
MSG_JITTER=2.0
# Максимум повторов при FloodWait
MAX_RETRIES=5
# Случайная стартовая задержка воркера (разброс запусков)
STARTUP_JITTER=3.0

# ---------------------------------------------------------------
# Мониторинг — live-dashboard в терминале (rich)
# ---------------------------------------------------------------
MONITOR_ENABLED=1


# ================================================================
# MODE=parse — Сбор пользователей (парсинг), без отправки сообщений
# ================================================================

# Источники — через запятую; пусто → берётся TG_TARGET_ENTITY выше.
PARSE_ENTITIES=

# members|comments|messages|reactions|polls|system|topic
PARSE_STRATEGY=members
# Обязателен при PARSE_STRATEGY=topic — ID корневого сообщения топика
# (см. src.extraction.data_extraction.list_forum_topics)
PARSE_TOPIC_ID=

# summary (один файл) | by_source (файл на источник) | full (оба сразу)
PARSE_EXPORT_MODE=full
# Путь к файлу (summary/full) или папке (by_source). Пусто — exports/parsed_*
PARSE_EXPORT_PATH=

# Фильтры результата (применяются до экспорта — фильтр определяет ИМЕННО
# то, что попадёт в Excel, в отличие от рассылки, где экспорт всегда полный)
PARSE_FILTER_LAST_SEEN_DAYS=
PARSE_FILTER_GENDER=
PARSE_FILTER_HAS_AVATAR=0
PARSE_FILTER_PREMIUM=0
# 1 — исключить ботов из результата (по умолчанию включено)
PARSE_FILTER_EXCLUDE_BOTS=1

# 1 — включить резюмируемость через Redis: прерванный и перезапущенный
# парсинг с тем же PARSE_JOB_KEY (или тем же набором PARSE_ENTITIES, если
# PARSE_JOB_KEY пуст) не возвращает повторно уже собранных пользователей.
# Заодно включает anti-flood: источник, по которому уже стучится другой
# параллельный parse-джоб на том же Redis, временно пропускается. Требует
# REDIS_URL (см. блок Redis выше).
PARSE_REDIS_DEDUP_ENABLED=0
# Явный идентификатор джоба для резюмируемости. Пусто — вычисляется
# автоматически из отсортированного списка PARSE_ENTITIES.
PARSE_JOB_KEY=


# ================================================================
# MODE=check_accounts — Проверка здоровья аккаунтов
# ================================================================

# 1 — дополнительно опросить @SpamBot (медленнее, но точнее)
ACCOUNT_CHECK_DEEP=0


# ================================================================
# MODE=check_proxies — Проверка прокси
# ================================================================

# Путь к JSON-файлу со списком прокси для проверки (формат см. в
# src/proxy/proxy_list.py) — НЕ те же прокси, что PROXY_HOST_i выше:
# этот режим проверяет произвольный список прокси до их привязки к
# аккаунтам, а не то, что уже назначено.
PROXY_LIST_JSON=
PROXY_CHECK_CONCURRENCY=10
# Путь для JSON-отчёта с результатами. Пусто — только консольная таблица.
PROXY_CHECK_REPORT_PATH=


# ================================================================
# MODE=convert_tdata — Конвертация tdata → session
# ================================================================
# Источник — TDATA_ACCOUNTS_DIR/TDATA_PASSWORDS_FILE из блока ОБЩЕЕ выше.

# Куда писать .session файлы (по умолчанию — SESSION_DIR)
TDATA_OUTPUT_DIR=sessions
# 1 — конвертировать ВСЕ аккаунты из каждой папки tdata (потолок opentele —
# 3 на папку), а не только основной
TDATA_ALL_ACCOUNTS=0


# ================================================================
# MODE=convert_session — Конвертация session → tdata
# ================================================================
# Папка с парами .session+.json (та же конвенция именования, что
# ACCOUNTS_DIR — см. src/accounts/account_loader.py). Файлы без пары
# .json пропускаются с предупреждением.
SESSION_CONVERT_DIR=

# Куда писать папки tdata — по одной подпапке на аккаунт (имя = имя .session)
SESSION_CONVERT_OUTPUT_DIR=tdata_exports
