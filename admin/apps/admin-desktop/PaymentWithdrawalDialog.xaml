<Window x:Class="TgPoolAdmin.PaymentWithdrawalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallet withdrawal" Width="540" Height="620"
        MinWidth="500" MinHeight="560" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Background="{StaticResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource DangerBrush}" Margin="0,0,9,0" />
                    <TextBlock Text="Withdraw wallet funds" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1" Width="44" Height="44" Background="Transparent" BorderThickness="0"
                        Padding="0" Click="CloseButton_OnClick" Content="×" ToolTip="Close" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,20,22,22">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="8" Background="{StaticResource AccentTintBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,3,0,0">
                            <TextBlock Text="{Binding SelectedUser.UsernameDisplay}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedUser.TelegramIdDisplay}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Wallet address" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedUser.Address}" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Width="30" Height="30" Margin="8,0,0,0" Padding="0"
                                Content="⧉" ToolTip="Copy wallet address" Click="CopyWalletAddress_OnClick" />
                    </Grid>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="On-chain" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedUser.OnChainBalanceDisplay}" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Database" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedUser.DatabaseBalanceDisplay}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Accounts" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedUser.TotalAccountsPurchased}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Total paid" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SelectedUser.TotalPaidDisplay}" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,17" />
                    <TextBlock Text="Operator" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding Actor, UpdateSourceTrigger=PropertyChanged}" Height="42"
                             VerticalContentAlignment="Center" Margin="0,0,0,14" />
                    <CheckBox Content="Withdraw full on-chain balance"
                              IsChecked="{Binding WithdrawFullBalance}" Margin="0,0,0,13" />
                    <TextBlock Text="Amount" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding WithdrawalAmount, UpdateSourceTrigger=PropertyChanged}" Height="42"
                             VerticalContentAlignment="Center" Margin="0,0,0,14">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="IsEnabled" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WithdrawFullBalance}" Value="False">
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Border Background="{StaticResource WarningTintBrush}" BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,15">
                        <TextBlock Text="⚠  This moves funds on-chain to the fixed treasury. The user's database purchasing balance is not reduced."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" LineHeight="17" />
                    </Border>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Height="42"
                            Command="{Binding WithdrawCommand}" Content="Withdraw to treasury" />
                    <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LastTransactionHash}" FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
