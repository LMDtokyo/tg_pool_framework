<Window x:Class="TgPoolAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="TG Pool Admin Panel" Width="1360" Height="860" MinWidth="1040" MinHeight="680"
        Icon="pack://application:,,,/Assets/logo.png"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="HoverBg" Background="Transparent" CornerRadius="10" />
                            <Border x:Name="ActivePill" Background="{StaticResource NavActiveGradientBrush}"
                                    CornerRadius="10" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="18"
                                                      ShadowDepth="0" Opacity="0.5" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HoverBg" Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActivePill" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="WalletCardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="270" />
            <Setter Property="Height" Value="326" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Height="16"
                           Stretch="Uniform" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="TG Pool Admin Panel" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleButtonStyle}" Click="MinimizeButton_Click">
                        <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="13" Height="13" />
                    </Button>
                    <Button Style="{StaticResource TitleButtonStyle}" Click="MaximizeButton_Click">
                        <iconPacks:PackIconMaterial Kind="WindowMaximize" Width="12" Height="12" />
                    </Button>
                    <Button Style="{StaticResource TitleCloseButtonStyle}" Click="CloseButton_Click">
                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="3" Background="{StaticResource SidebarGlassBrush}"
                                IsHitTestVisible="False" />
                        <StackPanel Margin="18,18,18,14">
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   Width="130" Height="46" Stretch="Uniform"
                                   HorizontalAlignment="Left" Margin="8,2,8,18"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <RadioButton Style="{StaticResource NavButtonStyle}" Tag="Dashboard"
                                         GroupName="Navigation"
                                         IsChecked="{Binding IsDashboard, Mode=OneWay}"
                                         Click="NavigationButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="ViewDashboardOutline"
                                                                 Width="18" Height="18" Margin="0,0,11,0" />
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButtonStyle}" Tag="WalletAdmin"
                                         GroupName="Navigation"
                                         IsChecked="{Binding IsWalletAdmin, Mode=OneWay}"
                                         Click="NavigationButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="WalletOutline"
                                                                 Width="18" Height="18" Margin="0,0,11,0" />
                                    <TextBlock Text="Administrator wallet" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButtonStyle}" Tag="Pricing"
                                         GroupName="Navigation"
                                         IsChecked="{Binding IsPricing, Mode=OneWay}"
                                         Click="NavigationButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="TagOutline"
                                                                 Width="18" Height="18" Margin="0,0,11,0" />
                                    <TextBlock Text="Retail pricing" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <Border Grid.Row="2" Margin="18,14,18,20" Padding="12,9" CornerRadius="10"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Dashboard metrics" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Cards show completed sales. The graph shows confirmed user wallet deposits."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="22,16,22,14"
                          Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Administrator key" Style="{StaticResource FieldLabelStyle}" />
                            <PasswordBox x:Name="AdminKeyBox" Height="40" VerticalContentAlignment="Center"
                                         PasswordChanged="AdminKeyBox_OnPasswordChanged"
                                         ToolTip="Kept in memory only" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Operator" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Actor, UpdateSourceTrigger=PropertyChanged}" Height="40"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="3" Height="40" Margin="12,18,0,0" MinWidth="128"
                                Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadCommand}"
                                Content="↻  Refresh all" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="22,0,22,8">
                        <Grid Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,4,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Financial dashboard" FontSize="25" FontWeight="SemiBold" />
                                    <TextBlock Text="Completed sales and confirmed wallet deposits in UTC."
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Period" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding SalesPeriodOptions}"
                                              SelectedItem="{Binding SelectedSalesPeriod}" Width="82" Height="36" />
                                    <Button Command="{Binding RefreshSalesCommand}" Content="Apply"
                                            Height="36" Margin="8,0,0,0" Padding="12,0" />
                                </StackPanel>
                            </Grid>
                            <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="Today" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="Account purchases" FontSize="9"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding TodayGrossDisplay}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource PurchaseChartBrush}" />
                                        <TextBlock Text="Wallet deposits" FontSize="9" Margin="0,5,0,0"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding TodayDepositedDisplay}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="Account purchases" FontSize="9"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding PeriodGrossDisplay}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource PurchaseChartBrush}" />
                                        <TextBlock Text="Wallet deposits" FontSize="9" Margin="0,5,0,0"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding PeriodDepositedDisplay}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="All time" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="Account purchases" FontSize="9"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding AllTimeGrossDisplay}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource PurchaseChartBrush}" />
                                        <TextBlock Text="Wallet deposits" FontSize="9" Margin="0,5,0,0"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding AllTimeDepositedDisplay}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel><TextBlock Text="Completed orders" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding PeriodCompletedOrders}" FontSize="21" FontWeight="Bold" /></StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel><TextBlock Text="Accounts sold" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding PeriodAccountsSold}" FontSize="21" FontWeight="Bold" /></StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Daily account purchases and wallet deposits"
                                                   FontSize="15" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Rectangle Width="18" Height="3" Fill="{StaticResource PurchaseChartBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Purchases" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,14,0" />
                                            <Rectangle Width="18" Height="3" Fill="{StaticResource DepositChartBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Deposits" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,18,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Viewbox Stretch="Fill">
                                            <Grid Width="1000" Height="300">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="260" />
                                                    <RowDefinition Height="40" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                        <RowDefinition />
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0,0,0,1" />
                                                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0,0,0,1" />
                                                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0,0,0,1" />
                                                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderStrongBrush}"
                                                            BorderThickness="0,0,0,1" />
                                                    <Canvas Grid.RowSpan="4">
                                                        <Polygon Points="{Binding DepositChartAreaPoints}"
                                                                 Fill="{StaticResource DepositChartAreaBrush}" />
                                                        <Polyline Points="{Binding PurchaseChartPoints}"
                                                                  Stroke="{StaticResource PurchaseChartBrush}"
                                                                  StrokeThickness="3" StrokeLineJoin="Round" />
                                                        <Polyline Points="{Binding DepositChartPoints}"
                                                                  Stroke="{StaticResource DepositChartBrush}"
                                                                  StrokeThickness="3" StrokeLineJoin="Round" />
                                                        <ItemsControl ItemsSource="{Binding DailyPurchases}"
                                                                      Width="1000" Height="260">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding PointLeft}" />
                                                                    <Setter Property="Canvas.Top" Value="{Binding PointTop}" />
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Ellipse Width="8" Height="8"
                                                                             Fill="{StaticResource SurfaceBrush}"
                                                                             Stroke="{StaticResource WarningBrush}"
                                                                             StrokeThickness="2"
                                                                             ToolTipService.InitialShowDelay="0"
                                                                             ToolTipService.BetweenShowDelay="0"
                                                                             ToolTipService.ShowDuration="60000"
                                                                             ToolTip="{Binding AmountDisplay}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding DailyDeposits}"
                                                                      Width="1000" Height="260">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding PointLeft}" />
                                                                    <Setter Property="Canvas.Top" Value="{Binding PointTop}" />
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Ellipse Width="8" Height="8"
                                                                             Fill="{StaticResource SurfaceBrush}"
                                                                             Stroke="{StaticResource SuccessBrush}"
                                                                             StrokeThickness="2"
                                                                             ToolTipService.InitialShowDelay="0"
                                                                             ToolTipService.BetweenShowDelay="0"
                                                                             ToolTipService.ShowDuration="60000"
                                                                             ToolTip="{Binding AmountDisplay}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Canvas>
                                                </Grid>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding DailyChartLabels}"
                                                              Width="1000" Height="40">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding PointLeft}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Date}" Width="90" FontSize="9"
                                                                       Foreground="{StaticResource TextFaintBrush}"
                                                                       TextAlignment="Center" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding IsWalletAdmin, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="20,18,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Wallet administration" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Inspect customer funds, purchase activity, and sweep on-chain balances."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Users" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding UserCount}" FontWeight="Bold" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,18,0" />
                                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                                              Width="160" Height="36" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="20,16,20,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Administrator wallet address" FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TreasuryDetails}"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                   Margin="0,4,0,10" />
                                        <TextBox Text="{Binding TreasuryAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="42" VerticalContentAlignment="Center"
                                                 FontFamily="Consolas" MinWidth="430"
                                                 ToolTip="Validated by the isolated payment signer" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                    Visibility="{Binding HasTreasuryBalance, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Wallet balance" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding TreasuryBalanceDisplay}" FontSize="14"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="·" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="14" Margin="8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TreasuryTrxBalanceDisplay}" FontSize="14"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                                Margin="14,0,0,0">
                                        <Button Height="42" MinWidth="92" Margin="0,0,8,0"
                                                Command="{Binding LoadTreasuryCommand}" Content="Load" />
                                        <Button Height="42" MinWidth="130"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding SaveTreasuryCommand}" Content="Save address" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.75*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Administrator key" Style="{StaticResource FieldLabelStyle}" />
                                    <PasswordBox Height="42" VerticalContentAlignment="Center"
                                                 PasswordChanged="AdminKeyBox_OnPasswordChanged"
                                                 ToolTip="Kept in memory only" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Operator" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding Actor, UpdateSourceTrigger=PropertyChanged}" Height="42"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Telegram ID, username, or wallet" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="42"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="5" Height="42" Margin="10,18,0,0" MinWidth="122"
                                        Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Refresh" Width="15" Height="15"
                                                                     Margin="0,0,7,0" Foreground="#0C0C0E" />
                                        <TextBlock Text="Load wallets" Foreground="#0C0C0E" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="20,0,6,10">
                                <ItemsControl ItemsSource="{Binding Users}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource WalletCardButtonStyle}" Click="WalletCard_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="92" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{StaticResource GlassAccentBackgroundBrush}">
                                                        <Grid ClipToBounds="True">
                                                            <iconPacks:PackIconMaterial Kind="Send" Width="96" Height="96"
                                                                 Foreground="{StaticResource AccentBrush}" Opacity="0.10"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                 Margin="0,0,14,-10" />
                                                            <Grid Margin="16">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="52" Height="52" CornerRadius="8"
                                                                        Background="{StaticResource SurfaceBrush}"
                                                                        BorderBrush="{StaticResource GlassBorderBrush}"
                                                                        BorderThickness="1">
                                                                    <iconPacks:PackIconMaterial Kind="AccountOutline"
                                                                         Width="25" Height="25"
                                                                         Foreground="{StaticResource AccentBrush}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="11,3,0,0">
                                                                    <Border Background="{StaticResource SurfaceBrush}"
                                                                            CornerRadius="8" Padding="8,3"
                                                                            HorizontalAlignment="Left">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <iconPacks:PackIconMaterial Kind="TagOutline"
                                                                                 Width="11" Height="11"
                                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                                 Margin="0,0,4,0" />
                                                                            <TextBlock Text="Telegram" FontSize="10" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding UsernameDisplay}"
                                                                               FontWeight="SemiBold" FontSize="13"
                                                                               Margin="0,7,0,0"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>

                                                    <Grid Grid.Row="1" Margin="16,14,16,12">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition /><ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Telegram ID" Style="{StaticResource FieldLabelStyle}" />
                                                                <TextBlock Text="{Binding TelegramIdDisplay}"
                                                                           FontSize="12" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="Username" Style="{StaticResource FieldLabelStyle}" />
                                                                <TextBlock Text="{Binding UsernameDisplay}" FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid Grid.Row="1" Margin="0,12,0,11">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="Wallet address" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBlock Grid.Row="1" Text="{Binding Address}" FontFamily="Consolas"
                                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Address}" />
                                                            <Button Grid.RowSpan="2" Grid.Column="1" Width="28" Height="28"
                                                                    Margin="8,0,0,0" Padding="0" VerticalAlignment="Center"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    ToolTip="Copy wallet address"
                                                                    Click="CopyWalletAddress_Click">
                                                                <iconPacks:PackIconMaterial Kind="ContentCopy"
                                                                     Width="15" Height="15"
                                                                     Foreground="{StaticResource TextMutedBrush}" />
                                                            </Button>
                                                        </Grid>
                                                        <Grid Grid.Row="2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition /><ColumnDefinition />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="On-chain" Style="{StaticResource FieldLabelStyle}" />
                                                                <TextBlock Text="{Binding OnChainBalanceDisplay}" FontSize="14"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource SuccessBrush}"
                                                                           ToolTip="{Binding ChainError}" />
                                                                <TextBlock Text="{Binding TrxBalanceDisplay}" FontSize="12"
                                                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           ToolTip="{Binding ChainError}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="Database" Style="{StaticResource FieldLabelStyle}" />
                                                                <TextBlock Text="{Binding DatabaseBalanceDisplay}"
                                                                           FontSize="14" FontWeight="Bold" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition /><ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <iconPacks:PackIconMaterial Kind="Package" Width="13" Height="13"
                                                                         Foreground="{StaticResource TextMutedBrush}"
                                                                         Margin="0,0,5,0" />
                                                                    <TextBlock Text="{Binding TotalAccountsPurchased}"
                                                                               FontWeight="SemiBold" FontSize="12" />
                                                                    <TextBlock Text="accounts purchased"
                                                                               Foreground="{StaticResource TextMutedBrush}"
                                                                               FontSize="10" Margin="4,0,0,0" />
                                                                </StackPanel>
                                                                <Border Grid.Column="1"
                                                                        Background="{StaticResource SuccessTintBrush}"
                                                                        CornerRadius="9" Padding="8,3">
                                                                    <TextBlock Text="{Binding TotalPaidDisplay}"
                                                                               Foreground="{StaticResource SuccessBrush}"
                                                                               FontWeight="SemiBold" FontSize="11" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Grid.Row="4" Margin="20,5,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource DangerBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <ProgressBar Grid.Column="1" Width="100" IsIndeterminate="True"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                             VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding IsPricing, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="20,18,20,0">
                                <TextBlock Text="Retail pricing" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Set the markup applied on top of Datamoll wholesale prices for catalog and purchases."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="20,16,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Administrator key" Style="{StaticResource FieldLabelStyle}" />
                                    <PasswordBox Height="42" VerticalContentAlignment="Center"
                                                 PasswordChanged="AdminKeyBox_OnPasswordChanged"
                                                 ToolTip="Kept in memory only" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Operator" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding Actor, UpdateSourceTrigger=PropertyChanged}" Height="42"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="3" Height="42" Margin="12,18,0,0" MinWidth="128"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding LoadPricingCommand}" Content="Load pricing" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="20,0,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top" Width="380">
                                    <StackPanel>
                                        <TextBlock Text="Markup values" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Default retail price = wholesale × (1 + percent / 100) + fixed."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                                   Margin="0,6,0,18" TextWrapping="Wrap" />
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Markup percent" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding MarkupPercent, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="42" VerticalContentAlignment="Center"
                                                         ToolTip="Example: 20 for a 20% markup" />
                                            </StackPanel>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="Markup fixed" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding MarkupFixed, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="42" VerticalContentAlignment="Center"
                                                         ToolTip="Example: 0.25 for a $0.25 fixed add-on" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <Button Margin="0,18,0,0" Height="42" MinWidth="140" HorizontalAlignment="Left"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding SavePricingCommand}" Content="Save markup" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="20,17,20,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Country pricing" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="Per-country markup, overriding the default for that country's accounts only."
                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Height="36" MinWidth="118" VerticalAlignment="Top"
                                                    Command="{Binding LoadCatalogPricingCommand}" Content="Load catalog" />
                                        </Grid>
                                        <DataGrid Grid.Row="1" Margin="20,0,20,16"
                                                  ItemsSource="{Binding CountryPricing}"
                                                  AutoGenerateColumns="False" IsReadOnly="False"
                                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                                  CanUserResizeRows="False" HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal" SelectionMode="Single"
                                                  SelectionUnit="FullRow">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Country" Binding="{Binding Country}"
                                                                     Width="70" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}"
                                                                     Width="50" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Wholesale" Binding="{Binding WholesaleRangeDisplay}"
                                                                     Width="85" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Retail now" Binding="{Binding RetailRangeDisplay}"
                                                                     Width="85" IsReadOnly="True" />
                                                <DataGridTemplateColumn Header="Status" Width="65" IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="Custom" FontSize="11" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       Visibility="{Binding HasOverride, Converter={StaticResource BoolToVisibility}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Markup %"
                                                                     Binding="{Binding MarkupPercent, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="75" />
                                                <DataGridTextColumn Header="Markup fixed"
                                                                     Binding="{Binding MarkupFixed, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="90" />
                                                <DataGridTemplateColumn Header="" Width="140">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <Button Content="Save" Height="30" MinWidth="52" Margin="0,0,6,0"
                                                                        Command="{Binding DataContext.SaveCountryPricingCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="Clear" Height="30" MinWidth="52"
                                                                        Command="{Binding DataContext.ClearCountryOverrideCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="3" Margin="20,5,20,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource DangerBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <ProgressBar Grid.Column="1" Width="100" IsIndeterminate="True"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                             VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2" Margin="22,3,22,12"
                          Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding LastTransactionHash}" FontFamily="Consolas"
                                       Foreground="{StaticResource TextFaintBrush}" FontSize="10" />
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Width="110" IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                     VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
