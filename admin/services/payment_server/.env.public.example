PAYMENT_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tg_pool_payments
# Dev-only fallback. In production, leave these blank and configure
# VAULT_ADDR/VAULT_ROLE_ID/VAULT_SECRET_ID instead -- see vault.py. Vault
# takes precedence whenever VAULT_ADDR is set.
DATAMOLL_PROVIDER_KEY=
DATAMOLL_PROVIDER_SECRET=
# HashiCorp Vault AppRole credentials, scoped to a read-only policy on
# secret/data/payment-server/datamoll. Leave VAULT_ADDR unset for local dev.
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
PAYMENT_CURRENCY=USD
PAYMENT_NETWORK=tron
PAYMENT_ASSET=USDT
PAYMENT_RETAIL_MARKUP_PERCENT=20
PAYMENT_RETAIL_MARKUP_FIXED=0.25
