{
  "components": {
    "schemas": {
      "GenerateKeysRequest": {
        "properties": {
          "count": {
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Count",
            "type": "integer"
          },
          "note": {
            "default": "",
            "maxLength": 200,
            "title": "Note",
            "type": "string"
          },
          "tier": {
            "$ref": "#/components/schemas/Tier"
          }
        },
        "required": [
          "tier",
          "count"
        ],
        "title": "GenerateKeysRequest",
        "type": "object"
      },
      "GenerateKeysResponse": {
        "properties": {
          "keys": {
            "items": {
              "$ref": "#/components/schemas/IssuedKeyOut"
            },
            "title": "Keys",
            "type": "array"
          }
        },
        "required": [
          "keys"
        ],
        "title": "GenerateKeysResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IssuedKeyOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "key_code": {
            "title": "Key Code",
            "type": "string"
          },
          "tier": {
            "$ref": "#/components/schemas/Tier"
          }
        },
        "required": [
          "id",
          "key_code",
          "tier"
        ],
        "title": "IssuedKeyOut",
        "type": "object"
      },
      "LicenseKeySummaryOut": {
        "properties": {
          "activated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activated At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "hwid_bound": {
            "title": "Hwid Bound",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "key_last4": {
            "title": "Key Last4",
            "type": "string"
          },
          "last_seen_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Seen At"
          },
          "note": {
            "title": "Note",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tier": {
            "title": "Tier",
            "type": "string"
          }
        },
        "required": [
          "id",
          "key_last4",
          "tier",
          "note",
          "status",
          "hwid_bound",
          "created_at"
        ],
        "title": "LicenseKeySummaryOut",
        "type": "object"
      },
      "ListKeysResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LicenseKeySummaryOut"
            },
            "title": "Items",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "title": "ListKeysResponse",
        "type": "object"
      },
      "Tier": {
        "enum": [
          "week",
          "month",
          "half_year",
          "year"
        ],
        "title": "Tier",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TG Pool administrator license API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/keys": {
      "get": {
        "operationId": "list_keys_admin_keys_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "x-admin-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Admin-Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListKeysResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Keys"
      },
      "post": {
        "operationId": "generate_keys_admin_keys_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-admin-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Admin-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateKeysRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateKeysResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Generate Keys"
      }
    },
    "/admin/keys/{key_id}/reset-device": {
      "post": {
        "operationId": "reset_device_admin_keys__key_id__reset_device_post",
        "parameters": [
          {
            "in": "path",
            "name": "key_id",
            "required": true,
            "schema": {
              "title": "Key Id",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "x-admin-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Admin-Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Reset Device Admin Keys  Key Id  Reset Device Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reset Device"
      }
    },
    "/admin/keys/{key_id}/revoke": {
      "post": {
        "operationId": "revoke_key_admin_keys__key_id__revoke_post",
        "parameters": [
          {
            "in": "path",
            "name": "key_id",
            "required": true,
            "schema": {
              "title": "Key Id",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "x-admin-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Admin-Key",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Revoke Key Admin Keys  Key Id  Revoke Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke Key"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
