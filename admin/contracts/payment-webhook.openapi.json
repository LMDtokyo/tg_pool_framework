{
  "components": {
    "schemas": {
      "DepositEventOut": {
        "properties": {
          "credited": {
            "title": "Credited",
            "type": "boolean"
          },
          "duplicate": {
            "default": false,
            "title": "Duplicate",
            "type": "boolean"
          },
          "newly_credited": {
            "default": false,
            "title": "Newly Credited",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "credited"
        ],
        "title": "DepositEventOut",
        "type": "object"
      },
      "DepositEventRequest": {
        "properties": {
          "address": {
            "maxLength": 128,
            "minLength": 10,
            "title": "Address",
            "type": "string"
          },
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "asset": {
            "default": "USDT",
            "maxLength": 16,
            "minLength": 1,
            "title": "Asset",
            "type": "string"
          },
          "confirmations": {
            "minimum": 0.0,
            "title": "Confirmations",
            "type": "integer"
          },
          "event_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Event Id",
            "type": "string"
          },
          "event_index": {
            "default": 0,
            "minimum": 0.0,
            "title": "Event Index",
            "type": "integer"
          },
          "network": {
            "default": "tron",
            "maxLength": 32,
            "minLength": 1,
            "title": "Network",
            "type": "string"
          },
          "transaction_hash": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Transaction Hash",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "address",
          "transaction_hash",
          "amount",
          "confirmations"
        ],
        "title": "DepositEventRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TG Pool payment webhook API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/webhooks/tron/deposits": {
      "post": {
        "operationId": "tron_deposit_webhooks_tron_deposits_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-webhook-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Webhook-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepositEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DepositEventOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Tron Deposit"
      }
    }
  }
}
