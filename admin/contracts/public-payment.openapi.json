{
  "components": {
    "schemas": {
      "BalanceOut": {
        "properties": {
          "available_balance": {
            "title": "Available Balance",
            "type": "string"
          },
          "balance": {
            "title": "Balance",
            "type": "string"
          },
          "credit_limit": {
            "default": "0",
            "title": "Credit Limit",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "balance",
          "available_balance",
          "currency"
        ],
        "title": "BalanceOut",
        "type": "object"
      },
      "CatalogOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProductOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "title": "CatalogOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "asset": {
            "title": "Asset",
            "type": "string"
          },
          "deposit_address": {
            "title": "Deposit Address",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "network": {
            "title": "Network",
            "type": "string"
          },
          "telegram_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Telegram User Id"
          },
          "telegram_username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Telegram Username"
          },
          "user_id": {
            "title": "User Id",
            "type": "integer"
          }
        },
        "required": [
          "user_id",
          "display_name",
          "deposit_address",
          "network",
          "asset"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "OrderOut": {
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "external_order_id": {
            "title": "External Order Id",
            "type": "string"
          },
          "items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Items",
            "type": "array"
          },
          "order_id": {
            "title": "Order Id",
            "type": "integer"
          },
          "payment_status": {
            "title": "Payment Status",
            "type": "string"
          },
          "product_id": {
            "title": "Product Id",
            "type": "integer"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "reused_existing": {
            "default": false,
            "title": "Reused Existing",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "total_amount": {
            "title": "Total Amount",
            "type": "string"
          },
          "unit_price": {
            "title": "Unit Price",
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "external_order_id",
          "status",
          "payment_status",
          "product_id",
          "quantity",
          "unit_price",
          "total_amount",
          "currency"
        ],
        "title": "OrderOut",
        "type": "object"
      },
      "OrderRequest": {
        "properties": {
          "external_order_id": {
            "maxLength": 255,
            "minLength": 1,
            "title": "External Order Id",
            "type": "string"
          },
          "product_id": {
            "minimum": 1.0,
            "title": "Product Id",
            "type": "integer"
          },
          "quantity": {
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "quantity",
          "external_order_id"
        ],
        "title": "OrderRequest",
        "type": "object"
      },
      "ProductOut": {
        "properties": {
          "category_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category Name"
          },
          "content_language": {
            "default": "",
            "title": "Content Language",
            "type": "string"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "max_order": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Order"
          },
          "min_order": {
            "minimum": 1.0,
            "title": "Min Order",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price": {
            "title": "Price",
            "type": "string"
          },
          "product_id": {
            "title": "Product Id",
            "type": "integer"
          },
          "stock": {
            "minimum": 0.0,
            "title": "Stock",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "name",
          "price",
          "currency",
          "stock",
          "min_order"
        ],
        "title": "ProductOut",
        "type": "object"
      },
      "RegeneratedKeyOut": {
        "properties": {
          "api_key": {
            "title": "Api Key",
            "type": "string"
          }
        },
        "required": [
          "api_key"
        ],
        "title": "RegeneratedKeyOut",
        "type": "object"
      },
      "TransactionOut": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "entry_type": {
            "title": "Entry Type",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency",
          "entry_type",
          "description",
          "created_at"
        ],
        "title": "TransactionOut",
        "type": "object"
      },
      "TransactionsOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TransactionOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "title": "TransactionsOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TG Pool public payment API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
