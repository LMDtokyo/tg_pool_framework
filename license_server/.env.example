# ================================================================
# license_server/.env.example — Конфигурация сервера лицензий
# Скопируй в license_server/.env и заполни. НИКОГДА НЕ КОММИТЬ .env!
# ================================================================

# База данных сервера лицензий — отдельная от базы клиентского бэкенда.
# Для продакшена — Postgres; для локальной разработки подойдёт SQLite.
LICENSE_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tg_pool_licenses
# LICENSE_DATABASE_URL=sqlite+aiosqlite:///license_server.db

# Секрет для admin-эндпоинтов (генерация/отзыв ключей). Держи только на
# своей машине и там, где запускаешь generate_keys.py — клиентам не нужен.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
LICENSE_ADMIN_API_KEY=

# 1 — подробное логирование SQL-запросов
DATABASE_ECHO=0

# Показывается консольным активатором (TgPoolActivator) как "актуальная версия".
# Обнови при каждом релизе лаунчера — редеплой самого license_server не нужен.
LATEST_LAUNCHER_VERSION=1.0.0
LATEST_LAUNCHER_NOTES=
