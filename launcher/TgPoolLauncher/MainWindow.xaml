<Window x:Class="TgPoolLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
        xmlns:loc="clr-namespace:TgPoolLauncher.Localization"
        mc:Ignorable="d"
        Title="TG Pool Launcher" Height="760" Width="1360" MinHeight="560" MinWidth="900"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="pack://application:,,,/Assets/logo.png"
        WindowStyle="None" ResizeMode="CanResize" Opacity="0">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                             GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <loc:EnumEqualsConverter x:Key="EnumEqualsConverter" />

        <Style x:Key="LanguageButtonBaseStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageButtonRuStyle" TargetType="Button" BasedOn="{StaticResource LanguageButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="CurrentLanguage"
                                 Converter="{StaticResource EnumEqualsConverter}" ConverterParameter="Ru" />
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#0C0C0E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LanguageButtonEnStyle" TargetType="Button" BasedOn="{StaticResource LanguageButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="CurrentLanguage"
                                 Converter="{StaticResource EnumEqualsConverter}" ConverterParameter="En" />
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#0C0C0E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LanguageButtonZhStyle" TargetType="Button" BasedOn="{StaticResource LanguageButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="CurrentLanguage"
                                 Converter="{StaticResource EnumEqualsConverter}" ConverterParameter="Zh" />
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#0C0C0E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg" CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Color="Transparent" />
                            </Border.Background>
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar" Grid.Column="0" Width="3" CornerRadius="1.5"
                                        Background="{StaticResource AccentBrush}" Opacity="0"
                                        HorizontalAlignment="Left" Margin="-12,-2,0,-2" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background.Color"
                                                            To="#28282D" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background.Color"
                                                            To="Transparent" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background.Color"
                                                            To="#2A3B82F6" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background.Color"
                                                            To="Transparent" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auto Register is a navigation group rather than a directly selectable page. -->
        <Style x:Key="NavGroupTabItemStyle" TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <ContentPresenter ContentSource="Header" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarGroupExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderButton" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                          BorderThickness="0" Padding="26,11,12,11" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBackground" Background="{TemplateBinding Background}" CornerRadius="10">
                                            <Grid Margin="{TemplateBinding Padding}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center" />
                                                <iconPacks:PackIconMaterial x:Name="Chevron" Grid.Column="1" Kind="ChevronDown"
                                                           Width="15" Height="15" Margin="8,0,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="HeaderBackground" Property="Background" Value="{StaticResource AccentTintBrush}" />
                                                <Setter TargetName="Chevron" Property="Kind" Value="ChevronUp" />
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarChildListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarChildItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="12,2,0,2" />
            <Setter Property="Padding" Value="18,0,10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" Margin="3,0,0,0" Background="{TemplateBinding Background}" CornerRadius="8" />
                            <Border x:Name="AccentBar" Width="3" Background="{StaticResource AccentBrush}" CornerRadius="1.5"
                                    HorizontalAlignment="Left" Margin="0,5,0,5" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentTintBrush}" />
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel LastChildFill="False">
                                    <Border DockPanel.Dock="Top" Margin="26,30,26,26">
                                        <Image Source="pack://application:,,,/Assets/logo.png"
                                               Width="130" Height="46" Stretch="Uniform"
                                               HorizontalAlignment="Left"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel DockPanel.Dock="Top" Margin="16,0">
                                        <TabPanel IsItemsHost="True" />
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Bottom" Margin="26,0,26,24">
                                        <TextBlock Text="{tr:Tr Common.Language}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="RU" Tag="Ru" Style="{StaticResource LanguageButtonRuStyle}"
                                                    Click="LanguageButton_Click" />
                                            <Button Content="EN" Tag="En" Style="{StaticResource LanguageButtonEnStyle}"
                                                    Click="LanguageButton_Click" />
                                            <Button Content="中文" Tag="Zh" Style="{StaticResource LanguageButtonZhStyle}"
                                                    Click="LanguageButton_Click" Margin="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Height="16" Stretch="Uniform"
                           HorizontalAlignment="Left" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="TG Pool Launcher" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click">
                        <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="13" Height="13" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click">
                        <iconPacks:PackIconMaterial Kind="WindowMaximize" Width="12" Height="12" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click">
                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" x:Name="RootTabs" TabStripPlacement="Left"
                        Style="{StaticResource SidebarTabControlStyle}"
                        ItemContainerStyle="{StaticResource NavTabItemStyle}"
                        SelectionChanged="RootTabs_SelectionChanged">
        <TabItem x:Name="DashboardTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ViewDashboard" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{tr:Tr Nav.Dashboard}" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="AccountsTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="AccountGroup" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{tr:Tr Nav.Accounts}" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="AutoRegisterTab" Style="{StaticResource NavGroupTabItemStyle}">
            <TabItem.Header>
                <StackPanel>
                    <Expander x:Name="AutoRegisterExpander" Style="{StaticResource SidebarGroupExpanderStyle}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AccountPlus" Width="16" Height="16" Margin="0,0,10,0"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Auto_Register" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <ListBox x:Name="AutoRegisterMenu"
                                 Style="{StaticResource SidebarChildListStyle}"
                                 ItemContainerStyle="{StaticResource SidebarChildItemStyle}"
                                 ItemsSource="{Binding Pages}"
                                 PreviewMouseLeftButtonUp="AutoRegisterMenu_PreviewMouseLeftButtonUp"
                                 SelectionChanged="AutoRegisterMenu_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                    <Expander x:Name="SendingSmsExpander" Style="{StaticResource SidebarGroupExpanderStyle}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="MessageText" Width="16" Height="16" Margin="0,0,10,0"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Sending SMS" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <ListBox x:Name="SendingSmsMenu"
                                 Style="{StaticResource SidebarChildListStyle}"
                                 ItemContainerStyle="{StaticResource SidebarChildItemStyle}"
                                 ItemsSource="{Binding SendingSmsPages}"
                                 PreviewMouseLeftButtonUp="SendingSmsMenu_PreviewMouseLeftButtonUp"
                                 SelectionChanged="SendingSmsMenu_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                    <Expander x:Name="InviteExpander" Style="{StaticResource SidebarGroupExpanderStyle}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AccountMultiplePlusOutline" Width="16" Height="16" Margin="0,0,10,0"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Invite" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <ListBox x:Name="InviteMenu"
                                 Style="{StaticResource SidebarChildListStyle}"
                                 ItemContainerStyle="{StaticResource SidebarChildItemStyle}"
                                 ItemsSource="{Binding InvitePages}"
                                 PreviewMouseLeftButtonUp="InviteMenu_PreviewMouseLeftButtonUp"
                                 SelectionChanged="InviteMenu_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="ProxyCheckTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Web" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{tr:Tr Nav.ProxyCheck}" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="ProxyPoolCheckerTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Autorenew" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{tr:Tr Nav.ProxyPoolChecker}" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="TdataConvertTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Archive" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Tdata" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="ParsingTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Magnify" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{tr:Tr Nav.Parsing}" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="SessionConvertTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Session→Tdata" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="JsonGeneratorTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CodeJson" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{tr:Tr Nav.JsonGenerator}" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="TextRandomizerTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ShuffleVariant" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Text Randomizer" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="EngagementTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="TrendingUp" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{tr:Tr Nav.Engagement}" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem x:Name="StoriesTab">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CircleMultipleOutline" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{tr:Tr Nav.Stories}" VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                </StackPanel>
            </TabItem.Header>
        </TabItem>
    </TabControl>
        </Grid>
    </Border>
</Window>
