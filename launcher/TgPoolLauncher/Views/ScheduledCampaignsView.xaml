<UserControl x:Class="TgPoolLauncher.Views.ScheduledCampaignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
             xmlns:conv="clr-namespace:TgPoolLauncher.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1040">
    <UserControl.Resources>
        <conv:CampaignTypeToLabelConverter x:Key="CampaignTypeToLabelConverter" />
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Background="{StaticResource AppBackgroundBrush}" Margin="16,16,16,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Form -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="28" Width="420" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{tr:Tr ScheduledCampaigns.NewSchedule}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" />

                        <StackPanel Style="{StaticResource FieldGroupStyle}">
                            <TextBlock Text="{tr:Tr ScheduledCampaigns.NameLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroupStyle}">
                            <TextBlock Text="{tr:Tr ScheduledCampaigns.CampaignTypeLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{tr:Tr ScheduledCampaigns.SendByIdOption}" GroupName="CampaignType"
                                             IsChecked="True" Margin="0,0,18,0" />
                                <RadioButton Content="{tr:Tr ScheduledCampaigns.SendByNumbersOption}" GroupName="CampaignType"
                                             IsChecked="{Binding IsSendByNumbers}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel" BasedOn="{StaticResource FieldGroupStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSendByNumbers}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{tr:Tr ScheduledCampaigns.DatabasePathLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="{tr:Tr Common.Browse}" Padding="12,6" Margin="8,0,0,0"
                                        Command="{Binding BrowseDatabasePathCommand}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel" BasedOn="{StaticResource FieldGroupStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSendByNumbers}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{tr:Tr ScheduledCampaigns.PhoneNumbersLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding PhoneNumbersText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldGroupStyle}">
                            <TextBlock Text="{tr:Tr ScheduledCampaigns.MessageLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <TextBlock Text="{tr:Tr ScheduledCampaigns.ScheduleHeader}" FontSize="13" FontWeight="Bold" Margin="0,4,0,12" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{tr:Tr ScheduledCampaigns.StartDateLabel}" Style="{StaticResource FieldLabelStyle}" />
                                <DatePicker SelectedDate="{Binding StartDate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{tr:Tr ScheduledCampaigns.StartTimeLabel}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{tr:Tr ScheduledCampaigns.RepeatIntervalLabel}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding RepeatIntervalHoursText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{tr:Tr ScheduledCampaigns.RepeatIntervalTooltip}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{tr:Tr ScheduledCampaigns.MaxOccurrencesLabel}" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding MaxOccurrencesText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{tr:Tr ScheduledCampaigns.MaxOccurrencesTooltip}" />
                            </StackPanel>
                        </Grid>

                        <Button Content="{tr:Tr ScheduledCampaigns.CreateButton}" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CreateCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}"
                                   Margin="0,14,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource EmptyStringToVisibilityConverter}, ConverterParameter=Invert}" />
                    </StackPanel>
                </Border>

                <!-- Scheduled campaigns -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="{tr:Tr ScheduledCampaigns.ListHeader}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,10" />

                    <TextBlock Text="{tr:Tr ScheduledCampaigns.EmptyListMessage}" FontSize="12"
                               Foreground="{StaticResource TextFaintBrush}" Margin="4,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Campaigns.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Campaigns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CampaignType, Converter={StaticResource CampaignTypeToLabelConverter}}"
                                                           FontSize="11" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{tr:Tr ScheduledCampaigns.DisabledBadge}" FontSize="11" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}"
                                                           Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2">
                                                <Run Text="{tr:Tr ScheduledCampaigns.NextRunLabel}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding NextRunAt, StringFormat='dd.MM.yyyy HH:mm', Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{StaticResource TextPrimaryBrush}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"
                                                       Visibility="{Binding RepeatIntervalHours, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Run Text="{tr:Tr ScheduledCampaigns.RepeatLabel}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding RepeatIntervalHours, Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{StaticResource TextPrimaryBrush}" />
                                                <Run Text="{tr:Tr ScheduledCampaigns.HoursSuffix}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding OccurrencesRun, Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{StaticResource TextPrimaryBrush}" />
                                                <Run Text="/" />
                                                <Run Text="{Binding MaxOccurrences, Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{StaticResource TextPrimaryBrush}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"
                                                       Visibility="{Binding LastRunAt, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Run Text="{tr:Tr ScheduledCampaigns.LastRunLabel}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding LastRunAt, StringFormat='dd.MM.yyyy HH:mm', Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{StaticResource TextPrimaryBrush}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                                       Visibility="{Binding LastError, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Run Text="{Binding LastError, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="{tr:Tr Common.Cancel}" Padding="10,5" FontSize="11" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{tr:Tr Common.Delete}" Padding="10,5" FontSize="11"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
