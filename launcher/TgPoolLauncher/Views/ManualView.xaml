<UserControl x:Class="TgPoolLauncher.Views.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- Local copy of Styles/AccountsTableStyles.xaml's SearchTextBoxStyle.
             That dictionary is only merged into AccountsView.xaml, not globally available. -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Category list -->
        <Border Grid.Column="0" Background="#17171A" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{tr:Tr Manual.NavHeader}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="4,2,4,12" />

                <Border DockPanel.Dock="Top" Background="#1F1F23" BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Height="34" Padding="10,0" Margin="0,0,0,10">
                    <Grid>
                        <iconPacks:PackIconMaterial Kind="Magnify" Width="13" Height="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock Text="{tr:Tr Manual.SearchPlaceholder}" Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="22,0,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                        <TextBox Style="{StaticResource SearchTextBoxStyle}" Margin="22,0,0,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>

                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,9" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A30" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#222226" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="{Binding Icon}" Width="16" Height="16"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"
                                                             Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13"
                                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Column="2" Background="#17171A" BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="1" Opacity="0.04" Color="Black" Direction="270" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24">
                <StackPanel>
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <iconPacks:PackIconMaterial Kind="{Binding SelectedCategory.Icon}" Width="24" Height="24"
                                                         Margin="0,0,12,0" VerticalAlignment="Center"
                                                         Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding SelectedCategory.Title}" FontSize="22" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedCategory.Body}" FontSize="14" LineHeight="24"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <TextBlock Text="{tr:Tr Manual.NoResults}" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding NoResults, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
