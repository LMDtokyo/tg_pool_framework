<UserControl x:Class="TgPoolLauncher.Views.ProxyCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1180">
    <UserControl.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style x:Key="RowActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
        <Style x:Key="ProxyStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ok">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="bad">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}"
                    Height="38" Margin="0,0,8,0" Command="{Binding CheckAllCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Magnify" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="{tr:Tr Proxy.CheckAll}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteAllCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="DeleteSweep" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="{tr:Tr Proxy.DeleteAll}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteBadCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="DeleteAlert" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="{tr:Tr Proxy.DeleteBad}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{tr:Tr Proxy.Timeout}" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding CheckTimeout, UpdateSourceTrigger=LostFocus}" Width="52" Height="32"
                         HorizontalContentAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="{tr:Tr Proxy.Retries}" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding RetryAttempts, UpdateSourceTrigger=LostFocus}" Width="44" Height="32"
                         HorizontalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Proxies}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" MinHeight="220"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="48" />
                    <DataGridTextColumn Header="{tr:Tr Proxy.ColHost}" Binding="{Binding Host}" Width="170" />
                    <DataGridTextColumn Header="{tr:Tr Proxy.ColPort}" Binding="{Binding Port}" Width="72" />
                    <DataGridTextColumn Header="{tr:Tr Proxy.ColLogin}" Binding="{Binding Username}" Width="115" />
                    <DataGridTextColumn Header="{tr:Tr Proxy.ColPassword}" Binding="{Binding Password}" Width="135" />
                    <DataGridTextColumn Header="{tr:Tr Proxy.ColType}" Binding="{Binding ProxyType}" Width="78" />
                    <DataGridTextColumn Header="{tr:Tr Proxy.ColVersion}" Binding="{Binding Version}" Width="72" />
                    <DataGridTextColumn Header="{tr:Tr Proxy.ColResponse}"
                                        Binding="{Binding ResponseMs, StringFormat={}{0:0} ms}" Width="96" />
                    <DataGridTemplateColumn Header="{tr:Tr Proxy.ColStatus}" Width="76">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource ProxyStatusStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{tr:Tr Proxy.ColGeo}" Binding="{Binding Country}" Width="62" />
                    <DataGridTemplateColumn Header="{tr:Tr Proxy.ColActions}" Width="82">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource RowActionButtonStyle}" ToolTip="{tr:Tr Proxy.CheckOne}"
                                            Command="{Binding DataContext.CheckProxyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" />
                                    </Button>
                                    <Button Style="{StaticResource RowActionButtonStyle}" ToolTip="{tr:Tr Proxy.DeleteOne}"
                                            Command="{Binding DataContext.DeleteProxyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <iconPacks:PackIconMaterial Kind="Delete" Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Margin="1"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{tr:Tr Proxy.AddSection}" FontSize="12"
                           FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{tr:Tr Proxy.Protocol}" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding SelectedProtocol}" Height="36" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="{tr:Tr Proxy.ProxyList}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ProxyListText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="88" FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        <TextBlock Text="{tr:Tr Proxy.AddFormat}" FontSize="11"
                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddCommand}" MinWidth="112" Height="38" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Width="16" Height="16" Margin="0,0,7,0" />
                            <TextBlock Text="{tr:Tr Proxy.AddButton}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}"
                   Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left"
                   TextWrapping="Wrap" IsHitTestVisible="False" />
    </Grid>
</UserControl>
