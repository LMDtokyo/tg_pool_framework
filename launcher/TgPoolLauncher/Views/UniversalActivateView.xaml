<UserControl x:Class="TgPoolLauncher.Views.UniversalActivateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1080">
    <UserControl.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="SettingTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="22">
                            <Border x:Name="Track" Background="{StaticResource BorderStrongBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="11" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Margin="3"
                                     HorizontalAlignment="Left" Fill="{StaticResource TextMutedBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="300" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.25*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Registration configuration -->
            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,18,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageTitleText" Text="{tr:Tr UniversalActivate.Title}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="PageSubtitleText" Text="{tr:Tr UniversalActivate.Subtitle}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" MinWidth="102" Height="32"
                                Background="{StaticResource AccentTintBrush}" CornerRadius="9" Padding="10,0">
                            <Grid>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource TextFaintBrush}"
                                         Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Text="{tr:Tr UniversalActivate.NotRunning}" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,0,14,20">
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{tr:Tr UniversalActivate.UseSmsServiceLabel}" Style="{StaticResource FieldLabelStyle}" />
                                            <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{tr:Tr UniversalActivate.SmsServiceLabel}" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="SmsServiceCombo" SelectedIndex="0" SelectedValuePath="Tag" Height="42">
                                                <ComboBoxItem Tag="hero-sms.com" Content="hero-sms.com" />
                                                <ComboBoxItem Tag="sms-activate.guru" Content="sms-activate.guru" />
                                                <ComboBoxItem Tag="5sim.net" Content="5sim.net" />
                                                <ComboBoxItem Tag="custom" Content="{tr:Tr UniversalActivate.ProviderCustom}" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{tr:Tr UniversalActivate.ApiKeyLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Height="44" Margin="0,0,0,14" ToolTip="{tr:Tr UniversalActivate.ApiKeyTooltip}" />

                                    <TextBlock Text="{tr:Tr UniversalActivate.RegistrationDatabaseLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Height="44" ToolTip="{tr:Tr UniversalActivate.RegistrationDatabaseTooltip}" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="11,6" ToolTip="{tr:Tr UniversalActivate.ChooseDatabaseFileTooltip}">
                                            <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="15" Height="15" />
                                        </Button>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="44" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tr:Tr UniversalActivate.BalanceLabel}"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Grid.Row="1" Grid.Column="0" Text="RUB  0.00"
                                                 Height="44" IsReadOnly="True" />
                                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                                Height="34" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="CloudDownloadOutline" Width="14" Height="14" Margin="0,0,7,0" />
                                                <TextBlock Text="{tr:Tr UniversalActivate.GetDataButton}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{tr:Tr UniversalActivate.AvailableCountriesLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox SelectedIndex="0" Height="42" Margin="0,0,0,14">
                                        <ComboBoxItem Content="{tr:Tr UniversalActivate.SelectCountryPlaceholder}" IsEnabled="False" />
                                    </ComboBox>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{tr:Tr UniversalActivate.AvailableOperatorsLabel}"
                                                   Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Grid.Row="1" Grid.Column="0" SelectedIndex="0" Height="42">
                                            <ComboBoxItem Content="{tr:Tr UniversalActivate.SelectOperatorPlaceholder}" IsEnabled="False" />
                                        </ComboBox>
                                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                                Height="34" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,7,0" />
                                                <TextBlock Text="{tr:Tr Common.Refresh}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{tr:Tr UniversalActivate.PricePerSmsLabel}" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="RUB  0.00" Height="44" IsReadOnly="True" />
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{tr:Tr UniversalActivate.NumbersAvailableLabel}" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="0" Height="44" IsReadOnly="True" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{tr:Tr UniversalActivate.RegistrationParametersHeader}" Style="{StaticResource SectionTitleStyle}" Margin="2,2,0,12" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,14">
                                    <TextBlock Text="{tr:Tr UniversalActivate.RegistrationTasksLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="5" Height="44" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{tr:Tr UniversalActivate.SmsTimeoutLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="300" Height="44" />
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource SettingTileStyle}">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.ActivateFreePrice}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}" Margin="0,0,0,10">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.ForceVoiceRequest}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.EmulateMobilePhone}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}" Margin="0,0,0,10">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.SetNamesFromFile}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.ResetSessionsUnder24h}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}" Margin="0,0,0,10">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.ForceReset2FA}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.Set2FA}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}" Margin="0,0,0,10">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.TurnOffStatistics}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.StreamsControl}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}" Margin="0,0,0,10">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.ProxySmsRequests}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.TemporaryEmail}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right"/></Grid>
                                </Border>
                                <Border Style="{StaticResource SettingTileStyle}" Margin="0,0,0,10">
                                    <Grid><TextBlock Text="{tr:Tr UniversalActivate.RejectCodeSentToApp}" VerticalAlignment="Center" FontSize="12" Margin="0,0,52,0" TextWrapping="Wrap"/><CheckBox Style="{StaticResource SwitchStyle}" HorizontalAlignment="Right" IsChecked="True"/></Grid>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Activity and guidance -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SectionCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="20,17,20,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{tr:Tr UniversalActivate.ProgramActivityHeader}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{tr:Tr UniversalActivate.ActivitySubtitle}" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr Common.Start}" IsEnabled="False">
                                    <iconPacks:PackIconMaterial Kind="Play" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr Common.Stop}" IsEnabled="False">
                                    <iconPacks:PackIconMaterial Kind="Stop" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="0" ToolTip="{tr:Tr UniversalActivate.ClearActivityTooltip}" IsEnabled="False">
                                    <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="15" Height="15" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" Margin="20,0" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{tr:Tr UniversalActivate.ColTime}" Width="100" />
                                <DataGridTextColumn Header="{tr:Tr UniversalActivate.ColAccount}" Width="150" />
                                <DataGridTextColumn Header="{tr:Tr UniversalActivate.ColMessage}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2" Margin="20,12,20,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{tr:Tr UniversalActivate.NoEventsYet}" Foreground="{StaticResource TextFaintBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{tr:Tr UniversalActivate.EventsCountZero}" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="10,0,0,0" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="20,17,20,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" Background="{StaticResource AccentTintBrush}" CornerRadius="8" Margin="0,0,10,0">
                                <iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{tr:Tr UniversalActivate.ImportantInfoHeader}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{tr:Tr UniversalActivate.ImportantInfoSubtitle}" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,0,14,18">
                            <StackPanel>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{tr:Tr UniversalActivate.NumberFilteringTitle}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" TextWrapping="Wrap" />
                                        <TextBlock Text="{tr:Tr UniversalActivate.NumberFilteringBody}"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{tr:Tr UniversalActivate.SmsTimeoutFallbackTitle}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" TextWrapping="Wrap" />
                                        <TextBlock Text="{tr:Tr UniversalActivate.SmsTimeoutFallbackBody}"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="9" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{tr:Tr UniversalActivate.SessionAnd2FATitle}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" TextWrapping="Wrap" />
                                        <TextBlock Text="{tr:Tr UniversalActivate.SessionAnd2FABody}"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
