<UserControl x:Class="TgPoolLauncher.Views.DatamollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1080">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*" MinWidth="410" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.4*" MinWidth="520" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20">
                    <TextBlock Text="DATAMOLL PROVIDER" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                    <TextBlock Text="Service" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="datamollcore.com" Height="44" IsReadOnly="True" Margin="0,0,0,12" />

                    <TextBlock Text="API key" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox Height="44" Margin="0,0,0,10"
                                 PasswordChanged="ApiKeyBox_OnPasswordChanged"
                                 ToolTip="Datamoll Provider API key" />
                    <TextBlock Text="API secret" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox Height="44" Margin="0,0,0,6"
                                 PasswordChanged="ApiSecretBox_OnPasswordChanged"
                                 ToolTip="Datamoll Provider API secret" />
                    <TextBlock Text="Credentials stay in memory and are sent only to the local backend and Datamoll."
                               Foreground="{StaticResource TextFaintBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,14" />

                    <TextBlock Text="Available balance" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BalanceDisplay, Mode=OneWay}" Height="44" IsReadOnly="True" />
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Margin="10,5,0,5"
                                Command="{Binding LoadBalanceCommand}" ToolTip="Refresh balance">
                            <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding BalanceErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <TextBlock Text="TELEGRAM PRODUCT" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,12" />
                    <TextBlock Text="Search country" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="44"
                                 Text="{Binding CountrySearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search by country name" />
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Margin="10,5,0,5"
                                Command="{Binding LoadCatalogCommand}" ToolTip="Load live catalog">
                            <iconPacks:PackIconMaterial Kind="Download" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <DataGrid Height="190" Margin="0,0,0,6"
                              ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Country" Binding="{Binding CountryName}" Width="*" MinWidth="110" />
                            <DataGridTextColumn Header="Age" Binding="{Binding AccountAge}" Width="82" />
                            <DataGridTextColumn Header="Price" Binding="{Binding PriceDisplay}" Width="74" />
                            <DataGridTextColumn Header="Available" Binding="{Binding AvailableDisplay}" Width="76" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding CatalogStatusMessage}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding CatalogErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SELECTED PRODUCT" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                            <UniformGrid Columns="4" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Country" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding CountryDisplay}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CountryDisplay}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Age" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding AccountAgeDisplay}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Price" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding UnitPriceDisplay}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Available" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding StockDisplay}" FontWeight="SemiBold" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding ProductDescription}" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" LineHeight="17" />
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Quantity" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Height="44" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Allowed quantity" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding OrderRangeDisplay, Mode=OneWay}" Height="44" IsReadOnly="True" />
                        </StackPanel>
                    </UniformGrid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Order total" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding TotalDisplay}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Purchase" Height="42" MinWidth="112"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding PurchaseCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding OperationStatusMessage}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding OperationErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2.1*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="1*" MinHeight="190" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,17,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PURCHASE ACTIVITY" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Live Datamoll order status"
                                       Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ClearCommand}" ToolTip="Clear activity">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <ProgressBar Grid.Row="1" Height="4" Margin="20,0,20,10"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsPurchasing, Converter={StaticResource BoolToVisibility}}" />
                    <DataGrid Grid.Row="2" Margin="20,0" ItemsSource="{Binding ActivityRows}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="76" />
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderId}" Width="74" />
                            <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="90" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="92" />
                            <DataGridTextColumn Header="Delivered" Binding="{Binding Delivered}" Width="74" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="1.4*" MinWidth="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Margin="20,12,20,16" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextFaintBrush}" FontSize="12">
                        <Run Text="{Binding EventCount, Mode=OneWay}" /><Run Text=" orders" />
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,17,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" Background="{StaticResource AccentTintBrush}"
                                CornerRadius="8" Margin="0,0,10,0">
                            <iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DATAMOLL DELIVERY" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Prepared Telegram account products are purchased directly from the catalog."
                                       Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,14,18">
                        <StackPanel>
                            <TextBlock Text="Purchases are real and deduct the displayed Datamoll balance. Stock and price are checked again when the order is placed."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10" />
                            <TextBlock Text="A retry reuses the same order identity, allowing Datamoll to recover delayed orders without charging twice."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10" />
                            <TextBlock Text="Delivered packages are downloaded automatically. Session accounts are added to Accounts, Telegram Desktop data is added to Tdata, and the private order receipt is retained."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
