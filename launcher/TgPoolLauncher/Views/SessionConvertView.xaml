<UserControl x:Class="TgPoolLauncher.Views.SessionConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="16,16,16,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="{tr:Tr SessionConvert.ListLabel}"
                       Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBox Text="{Binding ItemsText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6" Margin="0,0,0,8" AcceptsReturn="True" TextWrapping="NoWrap"
                     Height="110" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
            <Button Content="{tr:Tr SessionConvert.AddFromFolderButton}" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Command="{Binding AddFromFolderCommand}" />

            <TextBlock Text="{tr:Tr SessionConvert.OutputBaseLabel}" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding OutputBaseDir, UpdateSourceTrigger=PropertyChanged}" Padding="6" />
                <Button Grid.Column="1" Content="{tr:Tr Common.Browse}" Padding="12,6" Margin="8,0,0,0"
                        Command="{Binding BrowseOutputBaseDirCommand}" />
            </Grid>

            <StackPanel Orientation="Horizontal">
                <Button Content="{tr:Tr Tdata.ConvertButton}" Padding="20,8" HorizontalAlignment="Left"
                        Command="{Binding StartCommand}" />
                <ProgressBar Width="20" Height="20" Margin="12,0,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid Grid.Row="1" Margin="0,16,0,0" ItemsSource="{Binding Results}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{tr:Tr Tdata.ColSource}" Binding="{Binding Source}" Width="260" />
                <DataGridTextColumn Header="{tr:Tr SessionConvert.ColFolder}" Binding="{Binding Output}" Width="200" />
                <DataGridTextColumn Header="{tr:Tr Tdata.ColSuccess}" Binding="{Binding Success}" Width="70" />
                <DataGridTextColumn Header="{tr:Tr Tdata.ColError}" Binding="{Binding Error}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
    </ScrollViewer>
</UserControl>
