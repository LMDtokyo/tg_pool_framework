<UserControl x:Class="TgPoolLauncher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:TgPoolLauncher.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             Loaded="AccountsView_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/AccountsTableStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StatusToLabelConverter x:Key="StatusToLabelConverter" />
            <conv:StatusToBackgroundBrushConverter x:Key="StatusToBackgroundBrushConverter" />
            <conv:StatusToForegroundBrushConverter x:Key="StatusToForegroundBrushConverter" />
            <conv:CountryToFlagConverter x:Key="CountryToFlagConverter" />
            <conv:InitialsConverter x:Key="InitialsConverter" />
            <conv:NameToAvatarBrushConverter x:Key="NameToAvatarBrushConverter" />
            <conv:ProxyUsageLabelConverter x:Key="ProxyUsageLabelConverter" />
            <conv:ProxyUsageForegroundBrushConverter x:Key="ProxyUsageForegroundBrushConverter" />
            <conv:ProxyUsageTooltipConverter x:Key="ProxyUsageTooltipConverter" />
            <conv:RelativeAgeConverter x:Key="RelativeAgeConverter" />
            <conv:RelativeTimeConverter x:Key="RelativeTimeConverter" />
            <conv:IndexPlusOneConverter x:Key="IndexPlusOneConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#17171A" BorderBrush="{StaticResource TableBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="16,12,16,4">
            <!-- WrapPanel, not a fixed two-column Grid: at narrow widths the search/action
                 group wraps onto its own line instead of clipping the filter dropdowns. -->
            <WrapPanel Orientation="Horizontal">
                <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                          ItemContainerStyle="{StaticResource FilterComboBoxItemStyle}"
                          ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedStatusFilter}" MinWidth="130" />
                <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                          ItemContainerStyle="{StaticResource FilterComboBoxItemStyle}"
                          ItemsSource="{Binding RoleOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedRoleFilter}" MinWidth="110" />
                <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                          ItemContainerStyle="{StaticResource FilterComboBoxItemStyle}"
                          ItemsSource="{Binding GeoOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedGeoFilter}" MinWidth="90" />
                <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                          ItemContainerStyle="{StaticResource FilterComboBoxItemStyle}"
                          ItemsSource="{Binding FolderOptions}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedFolderFilter}" MinWidth="100" />
                <Button Style="{StaticResource IconButtonStyle}" Width="34"
                        Margin="0,0,8,8" ToolTip="{tr:Tr Accounts.MoreFiltersTooltip}">
                    <iconPacks:PackIconMaterial Kind="DotsHorizontal" Width="16" Height="16" />
                </Button>

                <Border Background="#1F1F23" BorderBrush="{StaticResource TableBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Width="220" Height="34" Padding="10,0"
                        Margin="16,0,8,8">
                    <Grid>
                        <iconPacks:PackIconMaterial Kind="Magnify" Width="13" Height="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock Text="{tr:Tr Common.SearchPlaceholder}" Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="22,0,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                        <TextBox Style="{StaticResource SearchTextBoxStyle}" Margin="22,0,0,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding LoadCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>
                <Button Margin="0,0,8,8" Command="{Binding LoadCommand}"
                        ToolTip="{tr:Tr Accounts.RefreshTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"
                                                     RenderTransformOrigin="0.5,0.5">
                            <iconPacks:PackIconMaterial.RenderTransform>
                                <RotateTransform Angle="0" />
                            </iconPacks:PackIconMaterial.RenderTransform>
                            <iconPacks:PackIconMaterial.Style>
                                <Style TargetType="iconPacks:PackIconMaterial">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="SpinStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                          From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconMaterial.Style>
                        </iconPacks:PackIconMaterial>
                        <TextBlock Text="{tr:Tr Common.Refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="{tr:Tr Accounts.RecheckPool}" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,8" Command="{Binding RecheckCommand}" />
                <ProgressBar IsIndeterminate="True" Width="60" Height="4" Margin="4,0,0,8"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}"
                    FontSize="12" Margin="4,10,0,0" />

        <!-- Table card -->
        <Border x:Name="TableCard" Grid.Row="2" Background="#17171A" BorderBrush="{StaticResource TableBorderBrush}"
                BorderThickness="1" CornerRadius="12" Margin="0,12,0,0" SizeChanged="TableCard_SizeChanged">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="1" Opacity="0.04" Color="Black" Direction="270" />
            </Border.Effect>

            <DataGrid ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="False"
                      CanUserReorderColumns="False" CanUserSortColumns="True"
                      GridLinesVisibility="None" HeadersVisibility="Column" RowHeaderWidth="0"
                      ColumnHeaderHeight="40" Background="#17171A" BorderThickness="0"
                      RowStyle="{StaticResource AccountsRowStyle}"
                      CellStyle="{StaticResource AccountsCellStyle}"
                      ColumnHeaderStyle="{StaticResource AccountsColumnHeaderStyle}"
                      AlternationCount="1000000">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Width="52" CanUserSort="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource RowCheckBoxStyle}"
                                          IsChecked="{Binding IsAllSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource RowCheckBoxStyle}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="#" Width="44" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                          Path=AlternationIndex,
                                                          Converter={StaticResource IndexPlusOneConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{tr:Tr Accounts.ColAccount}" Width="170" SortMemberPath="Account.Phone">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{Binding Account, Converter={StaticResource NameToAvatarBrushConverter}}">
                                        <TextBlock Text="{Binding Account, Converter={StaticResource InitialsConverter}}"
                                                   Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Account.Phone}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{tr:Tr Accounts.ColGeo}" Width="90" SortMemberPath="Account.Country">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Account.Country, Converter={StaticResource CountryToFlagConverter}}"
                                           FontFamily="Segoe UI Emoji" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{tr:Tr Accounts.ColStatus}" Width="140" SortMemberPath="Account.Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Account.Status, Converter={StaticResource StatusToBackgroundBrushConverter}}"
                                        CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Account.Status, Converter={StaticResource StatusToLabelConverter}}"
                                               Foreground="{Binding Account.Status, Converter={StaticResource StatusToForegroundBrushConverter}}"
                                               FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{tr:Tr Accounts.ColTracked}" Width="90" SortMemberPath="Account.FirstSeen">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Account.FirstSeen, Converter={StaticResource RelativeAgeConverter}}"
                                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{tr:Tr Accounts.ColRole}" Width="120" SortMemberPath="Account.Role">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Account.Role}" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Account.Role}" Value="">
                                                    <Setter Property="Text" Value="—" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{tr:Tr Accounts.ColProxy}" Width="190" SortMemberPath="Account.ProxyLabel">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            ToolTip="{Binding Account, Converter={StaticResource ProxyUsageTooltipConverter}}">
                                    <iconPacks:PackIconMaterial Kind="ServerNetwork" Width="14" Height="14"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                                               Foreground="{Binding Account, Converter={StaticResource ProxyUsageForegroundBrushConverter}}" />
                                    <TextBlock Text="{Binding Account, Converter={StaticResource ProxyUsageLabelConverter}}"
                                               Foreground="{Binding Account, Converter={StaticResource ProxyUsageForegroundBrushConverter}}"
                                               FontSize="13" TextTrimming="CharacterEllipsis"
                                               MaxWidth="155" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{tr:Tr Accounts.ColLastUsed}" Width="120" SortMemberPath="Account.LastChecked">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Account.LastChecked, Converter={StaticResource RelativeTimeConverter}}"
                                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{tr:Tr Accounts.ColName}" Width="150" SortMemberPath="Account.FirstName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Account.FirstName}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Account.FirstName}" Value="">
                                                    <Setter Property="Text" Value="{Binding Account.Username}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{tr:Tr Accounts.ColOther}" Width="160" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="{tr:Tr Accounts.TooltipFolder}">
                                        <iconPacks:PackIconMaterial Kind="Folder" Width="14" Height="14" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="{tr:Tr Accounts.TooltipUsername}">
                                        <iconPacks:PackIconMaterial Kind="At" Width="14" Height="14" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="2FA"
                                            Visibility="{Binding Account.Has2Fa, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconMaterial Kind="Lock" Width="14" Height="14" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="{tr:Tr Accounts.TooltipInfo}">
                                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="14" Height="14" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" ToolTip="{tr:Tr Accounts.TooltipMonitor}">
                                        <iconPacks:PackIconMaterial Kind="Monitor" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
