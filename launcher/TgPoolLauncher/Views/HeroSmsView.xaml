<UserControl x:Class="TgPoolLauncher.Views.HeroSmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1080">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <Grid Background="{StaticResource AppBackgroundBrush}" Margin="16,16,16,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*" MinWidth="320" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="1.45*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20">
                    <TextBlock Text="{tr:Tr HeroSms.AccountHeader}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                    <TextBlock Text="{tr:Tr HeroSms.ServiceLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="hero-sms.com" Height="44" IsReadOnly="True" Margin="0,0,0,12" />

                    <TextBlock Text="{tr:Tr HeroSms.ApiKeyLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="ApiKeyBox" Height="44" Margin="0,0,0,6"
                                 PasswordChanged="ApiKeyBox_OnPasswordChanged"
                                 ToolTip="{tr:Tr HeroSms.ApiKeyTooltip}" />
                    <TextBlock Text="{tr:Tr HeroSms.ApiKeyNote}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="0,0,0,14" />

                    <TextBlock Text="{tr:Tr HeroSms.BalanceLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BalanceDisplay}" Height="44" IsReadOnly="True" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Height="36" Margin="10,0,0,0"
                                VerticalAlignment="Center" Command="{Binding LoadBalanceCommand}" Content="{tr:Tr Common.Refresh}" />
                    </Grid>
                    <ProgressBar Height="3" Margin="0,0,0,6" IsIndeterminate="True"
                                 Visibility="{Binding IsLoadingBalance, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding BalanceErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <TextBlock Text="{tr:Tr HeroSms.ActivationHeader}" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,12" />
                    <TextBlock Text="{tr:Tr HeroSms.CountryLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding CountrySearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="44" Margin="0,0,0,6" VerticalContentAlignment="Center"
                             ToolTip="{tr:Tr HeroSms.CountrySearchTooltip}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox Height="42" ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}"
                                  DisplayMemberPath="DisplayName" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Height="36" Margin="10,0,0,0"
                                VerticalAlignment="Center" Command="{Binding LoadCountriesCommand}" Content="{tr:Tr HeroSms.LoadButton}" />
                    </Grid>
                    <ProgressBar Height="3" Margin="0,0,0,4" IsIndeterminate="True"
                                 Visibility="{Binding IsLoadingCountries, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding CountriesStatusMessage}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding CountriesErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <TextBlock Text="{tr:Tr HeroSms.OperatorLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox Height="42" ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}"
                                  DisplayMemberPath="DisplayName" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Height="36" Margin="10,0,0,0"
                                VerticalAlignment="Center" Command="{Binding RefreshCatalogCommand}" Content="{tr:Tr Common.Refresh}" />
                    </Grid>
                    <ProgressBar Height="3" Margin="0,0,0,4" IsIndeterminate="True"
                                 Visibility="{Binding IsLoadingCatalog, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{tr:Tr HeroSms.OperatorAutoLoadNote}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="0,0,0,12" />

                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{tr:Tr HeroSms.StartPriceLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Height="44"
                                      ItemsSource="{Binding PriceOptions}"
                                      SelectedItem="{Binding SelectedPriceOption}"
                                      DisplayMemberPath="DisplayName" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{Binding AvailabilityLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding AvailabilityDisplay, Mode=OneWay}" Height="44" IsReadOnly="True" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{tr:Tr HeroSms.PurchaseCeilingLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Height="44" Margin="0,0,0,6"
                              ItemsSource="{Binding CeilingPriceOptions}"
                              SelectedItem="{Binding SelectedCeilingOption}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Text="{tr:Tr HeroSms.PurchaseCeilingNote}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding CatalogStatusMessage}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding CatalogErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{tr:Tr HeroSms.AccountsToCreateLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding TargetAccountCount, UpdateSourceTrigger=PropertyChanged}" Height="44" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{tr:Tr HeroSms.ConcurrentPhonesLabel}" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ConcurrentPhoneCount, UpdateSourceTrigger=PropertyChanged}" Height="44" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{tr:Tr HeroSms.SmsTimeoutLabel}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding SmsTimeout, UpdateSourceTrigger=PropertyChanged}" Height="44" Margin="0,0,0,10" />
                    <Border Background="{StaticResource AccentTintBrush}" CornerRadius="8" Padding="12" Margin="0,4,0,10">
                        <TextBlock Text="{tr:Tr HeroSms.PhonesActiveNote}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="17" />
                    </Border>
                    <TextBlock Text="{Binding OperationStatusMessage}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding OperationErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="1.35*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="20,17,20,14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{tr:Tr HeroSms.ActivityHeader}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{tr:Tr HeroSms.ActivitySubheader}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding StartCommand}" ToolTip="{tr:Tr HeroSms.StartActivationsTooltip}">
                                <iconPacks:PackIconMaterial Kind="Play" Width="15" Height="15" />
                            </Button>
                            <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding StopCommand}" ToolTip="{tr:Tr HeroSms.StopActivationsTooltip}">
                                <iconPacks:PackIconMaterial Kind="Stop" Width="15" Height="15" />
                            </Button>
                            <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ClearCommand}" Margin="0" ToolTip="{tr:Tr HeroSms.ClearActivityTooltip}">
                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="15" Height="15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Grid.Row="1" Height="3" Margin="20,0,20,10" IsIndeterminate="True"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <DataGrid Grid.Row="2" Margin="20,0" ItemsSource="{Binding ActivityRows}"
                              SelectedItem="{Binding SelectedActivityRow}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{tr:Tr HeroSms.ColTime}" Binding="{Binding TimeDisplay}" Width="76" />
                            <DataGridTextColumn Header="{tr:Tr HeroSms.ColPhone}" Binding="{Binding PhoneNumber}" Width="125" />
                            <DataGridTextColumn Header="{tr:Tr HeroSms.ColOperator}" Binding="{Binding Operator}" Width="90" />
                            <DataGridTextColumn Header="{tr:Tr HeroSms.ColCost}" Binding="{Binding Cost, StringFormat=USD {0:0.####}}" Width="82" />
                            <DataGridTextColumn Header="{tr:Tr HeroSms.ColStage}" Binding="{Binding Stage}" Width="115" />
                            <DataGridTextColumn Header="{tr:Tr HeroSms.ColCode}" Binding="{Binding Code}" Width="80" />
                            <DataGridTextColumn Header="{tr:Tr HeroSms.ColMessage}" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="20,12,20,16">
                        <TextBlock Text="{tr:Tr HeroSms.PendingCanceledNote}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextFaintBrush}" FontSize="12" />
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextFaintBrush}" FontSize="12">
                            <Run Text="{Binding EventCount, Mode=OneWay}" /><Run Text="{tr:Tr HeroSms.EventsSuffix}" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                    Visibility="{Binding SelectedActivityRow.NeedsTwoFactor, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{tr:Tr HeroSms.TwoFactorHeader}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,8">
                            <Run Text="{tr:Tr HeroSms.TwoFactorPromptPrefix}" /><Run Text="{Binding SelectedActivityRow.PhoneNumber, Mode=OneWay}" />
                        </TextBlock>
                        <PasswordBox x:Name="TwoFactorPasswordBox" Height="40"
                                     PasswordChanged="TwoFactorPasswordBox_OnPasswordChanged" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{tr:Tr HeroSms.SubmitTwoFactorButton}" Margin="14,20,0,0"
                            Height="40" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SubmitTwoFactorCommand}" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="20,17,20,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" Background="{StaticResource AccentTintBrush}" CornerRadius="8" Margin="0,0,10,0">
                            <iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16"
                                                        Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{tr:Tr HeroSms.ImportantInfoHeader}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{tr:Tr HeroSms.ImportantInfoSubheader}" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,14,18">
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{tr:Tr HeroSms.RealPurchasesHeader}" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBlock Text="{tr:Tr HeroSms.RealPurchasesText}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" />
                                <TextBlock Text="{tr:Tr HeroSms.PriceAvailabilityHeader}" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBlock Text="{tr:Tr HeroSms.PriceAvailabilityText}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" />
                                <TextBlock Text="{tr:Tr HeroSms.LifecycleHeader}" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBlock Text="{tr:Tr HeroSms.LifecycleText}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
