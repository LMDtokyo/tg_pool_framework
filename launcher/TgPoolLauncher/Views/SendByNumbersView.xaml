<UserControl x:Class="TgPoolLauncher.Views.SendByNumbersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1180">
    <UserControl.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Background" Value="#3A1414" />
            <Setter Property="BorderBrush" Value="#5C1414" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style x:Key="CompactActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackgroundBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#1F2A38" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="EnabledHalf" Grid.Column="0" CornerRadius="5" Background="{StaticResource AccentBrush}">
                                    <iconPacks:PackIconMaterial Kind="Check" Width="15" Height="15"
                                                               Foreground="#0C0C0E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="DisabledHalf" Grid.Column="1" CornerRadius="5" Background="#5C1414">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="EnabledHalf" Property="Opacity" Value="1" />
                                <Setter TargetName="DisabledHalf" Property="Opacity" Value="0.25" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="EnabledHalf" Property="Opacity" Value="0.25" />
                                <Setter TargetName="DisabledHalf" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingCellStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,14,14" />
        </Style>

        <Style x:Key="OptionValueTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AutoStopFieldStyle" TargetType="TextBox" BasedOn="{StaticResource OptionValueTextBoxStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="ModalCardStyle" TargetType="Border">
            <Setter Property="Width" Value="450" />
            <Setter Property="Padding" Value="28" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16,16,16,96">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{tr:Tr SendByNumbers.WorkWithTextHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                <Button Grid.Column="1" Style="{StaticResource DangerIconButtonStyle}" Margin="0"
                                        ToolTip="{tr:Tr SendByNumbers.ClearMessageTooltip}" Click="ClearMessageButton_Click">
                                    <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="14" Height="14" />
                                </Button>
                            </Grid>

                            <WrapPanel Margin="0,0,0,10">
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr SendByNumbers.BoldTooltip}" Click="BoldButton_Click">
                                    <iconPacks:PackIconMaterial Kind="FormatBold" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr SendByNumbers.ItalicTooltip}" Click="ItalicButton_Click">
                                    <iconPacks:PackIconMaterial Kind="FormatItalic" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr SendByNumbers.CodeTooltip}" Click="CodeButton_Click">
                                    <iconPacks:PackIconMaterial Kind="CodeTags" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr SendByNumbers.AddLinkTooltip}" Click="LinkButton_Click">
                                    <iconPacks:PackIconMaterial Kind="LinkVariant" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr SendByNumbers.RepostFromChannelTooltip}" Click="ForwardButton_Click">
                                    <iconPacks:PackIconMaterial Kind="Repeat" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr SendByNumbers.AttachFileTooltip}" Click="AttachFileButton_Click">
                                    <iconPacks:PackIconMaterial Kind="FileDownloadOutline" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr SendByNumbers.RepostViaPostbotTooltip}" Click="PostbotButton_Click">
                                    <iconPacks:PackIconMaterial Kind="RobotOutline" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr SendByNumbers.TextRandomizerTooltip}" Click="RandomizerButton_Click">
                                    <iconPacks:PackIconMaterial Kind="ShuffleVariant" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="0"
                                        ToolTip="{tr:Tr SendByNumbers.InsertRecipientPhoneTooltip}" Click="PhoneButton_Click">
                                    <iconPacks:PackIconMaterial Kind="AccountOutline" Width="16" Height="16" />
                                </Button>
                            </WrapPanel>

                            <TextBox x:Name="MessageTextBox"
                                     Height="156"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="MessageTextBox_TextChanged" />
                            <TextBlock x:Name="MessageSourceText"
                                       Margin="2,9,0,0"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{tr:Tr SendByNumbers.SettingsHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource CompactActionButtonStyle}"
                                ToolTip="{tr:Tr SendByNumbers.ResetTooltip}" Click="ResetButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock Text="{tr:Tr SendByNumbers.ResetButton}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <StackPanel Style="{StaticResource SettingCellStyle}">
                                    <TextBlock Text="{tr:Tr SendByNumbers.PhoneNumbersLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PhoneNumbersTextBox" Height="44"
                                                 ToolTip="{tr:Tr SendByNumbers.PhoneNumbersTooltip}" />
                                        <Button Grid.Column="1" Margin="6,0,0,0" Padding="0"
                                                ToolTip="{tr:Tr SendByNumbers.ImportPhoneNumbersTooltip}" Click="BrowsePhoneNumbersButton_Click">
                                            <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingCellStyle}" Margin="0,0,0,14">
                                    <TextBlock Text="{tr:Tr SendByNumbers.SmsPerAccountLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <UniformGrid Columns="2">
                                        <TextBox x:Name="SmsMinTextBox" Height="44" Margin="0,0,7,0" />
                                        <TextBox x:Name="SmsMaxTextBox" Height="44" />
                                    </UniformGrid>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingCellStyle}">
                                    <TextBlock Text="{tr:Tr SendByNumbers.DelayLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <UniformGrid Columns="2">
                                        <TextBox x:Name="DelayMinTextBox" Height="44" Margin="0,0,7,0" />
                                        <TextBox x:Name="DelayMaxTextBox" Height="44" />
                                    </UniformGrid>
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingCellStyle}" Margin="0,0,0,14">
                                    <TextBlock Text="{tr:Tr SendByNumbers.FloodWaitLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="FloodWaitTextBox" Height="44" />
                                </StackPanel>
                            </UniformGrid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{tr:Tr SendByNumbers.SelectAccountsLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="SelectedAccountsTextBox" Height="44" IsReadOnly="True" />
                                </StackPanel>
                                <Button Grid.Column="2" Height="44" VerticalAlignment="Bottom"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="SelectAccountsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AccountOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                        <TextBlock Text="{tr:Tr SendByNumbers.SelectAccountsButton}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <UniformGrid Columns="2">
                                <StackPanel Style="{StaticResource SettingCellStyle}">
                                    <TextBlock Text="{tr:Tr SendByNumbers.DeleteDialogLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ToggleButton x:Name="DeleteDialogToggle" Style="{StaticResource OptionToggleStyle}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingCellStyle}" Margin="0,0,0,14">
                                    <TextBlock Text="{tr:Tr SendByNumbers.PreviewLinksLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ToggleButton x:Name="PreviewLinksToggle" Style="{StaticResource OptionToggleStyle}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingCellStyle}">
                                    <TextBlock Text="{tr:Tr SendByNumbers.SilentModeLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ToggleButton x:Name="SilentModeToggle" Style="{StaticResource OptionToggleStyle}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingCellStyle}" Margin="0,0,0,14">
                                    <TextBlock Text="{tr:Tr SendByNumbers.AutoRepostLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ToggleButton x:Name="AutoRepostToggle" Style="{StaticResource OptionToggleStyle}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource SettingCellStyle}" Margin="0,0,14,0">
                                    <TextBlock Text="{tr:Tr SendByNumbers.RemoveImportedContactsLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ToggleButton x:Name="RemoveImportedContactsToggle" Style="{StaticResource OptionToggleStyle}" />
                                </StackPanel>
                                <StackPanel Margin="0">
                                    <TextBlock Text="{tr:Tr SendByNumbers.PinMessageLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ToggleButton x:Name="PinMessageToggle" Style="{StaticResource OptionToggleStyle}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{tr:Tr SendByNumbers.SendingFilesHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,12" />
                    <Border Style="{StaticResource SectionCardStyle}">
                        <UniformGrid Columns="2">
                            <StackPanel Style="{StaticResource SettingCellStyle}" Margin="0,0,14,0">
                                <TextBlock Text="{tr:Tr SendByNumbers.VideoCircleLabel}" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="VideoCircleToggle" Style="{StaticResource OptionToggleStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{tr:Tr SendByNumbers.SelfDestructLabel}" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton x:Name="SelfDestructToggle" Style="{StaticResource OptionToggleStyle}" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <TextBlock Text="{tr:Tr SendByNumbers.AdditionalSettingsHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,12" />
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{tr:Tr SendByNumbers.SendingByTimeLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ToggleButton x:Name="SendingByTimeToggle" Style="{StaticResource OptionToggleStyle}" />
                                    <TextBox x:Name="ScheduleAtTextBox"
                                             Style="{StaticResource OptionValueTextBoxStyle}"
                                             IsEnabled="{Binding IsChecked, ElementName=SendingByTimeToggle}"
                                             ToolTip="{tr:Tr SendByNumbers.ScheduleAtTooltip}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{tr:Tr SendByNumbers.StreamsControlLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ToggleButton x:Name="StreamsControlToggle" Style="{StaticResource OptionToggleStyle}" />
                                    <TextBox x:Name="StreamsTextBox"
                                             Style="{StaticResource OptionValueTextBoxStyle}"
                                             IsEnabled="{Binding IsChecked, ElementName=StreamsControlToggle}"
                                             ToolTip="{tr:Tr SendByNumbers.StreamsTooltip}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{tr:Tr SendByNumbers.AutoStopLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ToggleButton x:Name="AutoStopToggle" Style="{StaticResource OptionToggleStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{tr:Tr SendByNumbers.RunControlLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <ToggleButton x:Name="RunControlToggle" Style="{StaticResource OptionToggleStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="3.3*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{tr:Tr SendByNumbers.AutoStopBanLabel}" Style="{StaticResource FieldLabelStyle}" FontSize="10" Margin="0,0,0,4" />
                                    <TextBox x:Name="AutoStopBanTextBox"
                                             Style="{StaticResource AutoStopFieldStyle}"
                                             IsEnabled="{Binding IsChecked, ElementName=AutoStopToggle}"
                                             ToolTip="{tr:Tr SendByNumbers.AutoStopBanTooltip}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SpamBlock" Style="{StaticResource FieldLabelStyle}" FontSize="10" Margin="0,0,0,4" />
                                    <TextBox x:Name="AutoStopSpamblockTextBox"
                                             Style="{StaticResource AutoStopFieldStyle}"
                                             IsEnabled="{Binding IsChecked, ElementName=AutoStopToggle}"
                                             ToolTip="{tr:Tr SendByNumbers.AutoStopSpamBlockTooltip}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="FloodWait" Style="{StaticResource FieldLabelStyle}" FontSize="10" Margin="0,0,0,4" />
                                    <TextBox x:Name="AutoStopFloodWaitTextBox"
                                             Style="{StaticResource AutoStopFieldStyle}"
                                             IsEnabled="{Binding IsChecked, ElementName=AutoStopToggle}"
                                             ToolTip="{tr:Tr SendByNumbers.AutoStopFloodWaitTooltip}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="{tr:Tr SendByNumbers.RepeatHoursLabel}" Style="{StaticResource FieldLabelStyle}" FontSize="10" Margin="0,0,0,4" />
                                    <TextBox x:Name="RepeatHoursTextBox"
                                             Style="{StaticResource AutoStopFieldStyle}"
                                             HorizontalContentAlignment="Left"
                                             IsEnabled="{Binding IsChecked, ElementName=RunControlToggle}"
                                             ToolTip="{tr:Tr SendByNumbers.RepeatHoursTooltip}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Style="{StaticResource SettingCellStyle}" Margin="0,14,0,0">
                                <TextBlock Text="{tr:Tr SendByNumbers.RequireProxyLabel}" Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="{tr:Tr SendByNumbers.RequireProxyTooltip}" />
                                <ToggleButton x:Name="RequireProxyToggle" Style="{StaticResource OptionToggleStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="{tr:Tr SendByNumbers.MessageViewHeader}" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Height="216"
                                    Padding="14"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="PreviewTextBlock"
                                               TextWrapping="Wrap"
                                               LineHeight="21"
                                               TextOptions.TextFormattingMode="Display"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{tr:Tr SendByNumbers.ProgramActionsHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="StartButton"
                                            Style="{StaticResource ToolbarIconButtonStyle}"
                                            ToolTip="{tr:Tr Common.Start}"
                                            Click="StartButton_Click">
                                        <iconPacks:PackIconMaterial Kind="Play" Width="15" Height="15" />
                                    </Button>
                                    <Button x:Name="StopButton"
                                            Style="{StaticResource ToolbarIconButtonStyle}"
                                            ToolTip="{tr:Tr Common.Stop}"
                                            IsEnabled="False"
                                            Click="StopButton_Click">
                                        <iconPacks:PackIconMaterial Kind="Stop" Width="15" Height="15" />
                                    </Button>
                                    <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="0"
                                            ToolTip="{tr:Tr Common.ClearLog}" Click="ClearActionsButton_Click">
                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="15" Height="15" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="ProgramActionsGrid"
                                      Height="360"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{tr:Tr SendByNumbers.LogColTime}" Binding="{Binding Time}" Width="82" />
                                    <DataGridTextColumn Header="{tr:Tr SendByNumbers.LogColAccount}" Binding="{Binding Account}" Width="140" />
                                    <DataGridTextColumn Header="{tr:Tr SendByNumbers.LogColMessage}" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{tr:Tr Common.ResultsHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6" />
                                <TextBlock x:Name="ResultsSummaryText"
                                           Text="{tr:Tr SendByNumbers.NoResultsYet}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextFaintBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource CompactActionButtonStyle}"
                                    ToolTip="{tr:Tr Common.Open}" Click="OpenResultsButton_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{tr:Tr Common.Open}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="ModalOverlay" Visibility="Collapsed" Background="#B8000000">
            <Border Style="{StaticResource ModalCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ModalTitleText"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ModalSubtitleText"
                                       Margin="0,8,18,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                Margin="0"
                                ToolTip="{tr:Tr SendByNumbers.ModalCloseTooltip}"
                                Click="CloseModalButton_Click">
                            <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <StackPanel x:Name="ForwardModalPanel" Visibility="Collapsed">
                        <TextBox x:Name="ForwardLinksTextBox"
                                 Height="176"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel x:Name="FileModalPanel" Visibility="Collapsed">
                        <Button Height="48" Click="ChooseLocalFileButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Laptop" Width="18" Height="18" Margin="0,0,9,0" />
                                <TextBlock Text="{tr:Tr SendByNumbers.ChooseLocalFileButton}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="AttachmentLinkTextBox"
                                 Height="132"
                                 Margin="0,14,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel x:Name="PostbotModalPanel" Visibility="Collapsed">
                        <TextBlock Text="{tr:Tr SendByNumbers.BotUsernameLabel}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="PostbotNameTextBox" Height="44" />
                        <TextBlock Text="{tr:Tr SendByNumbers.PostIdsLabel}" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                        <TextBox x:Name="PostbotIdsTextBox"
                                 Height="132"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel x:Name="AccountsModalPanel" Visibility="Collapsed">
                        <ListBox x:Name="AccountsListBox"
                                 Height="250"
                                 ItemsSource="{Binding}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Phone}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Margin="10,0,0,0"
                                                       Foreground="{StaticResource TextFaintBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <Button x:Name="ModalApplyButton"
                            Margin="0,22,0,0"
                            Height="46"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{tr:Tr SendByNumbers.ModalApplyButton}"
                            Click="ModalApplyButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
