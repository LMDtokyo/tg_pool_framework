<UserControl x:Class="TgPoolLauncher.Views.SendByNumbersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:tr="clr-namespace:TgPoolLauncher.Localization.Markup"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1180">
    <UserControl.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Background" Value="#3A1414" />
            <Setter Property="BorderBrush" Value="#5C1414" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style x:Key="CompactTextButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Width" Value="82" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#0C0C0E" />
        </Style>

        <Style x:Key="MutedInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <Style x:Key="PlaceholderToggleStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="ToolTip" Value="{tr:Tr Common.NotImplementedTooltip}" />
            <Setter Property="Cursor" Value="Help" />
        </Style>

        <Style x:Key="ToggleHalfLeftStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            <Setter Property="CornerRadius" Value="8,0,0,8" />
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <Style x:Key="ToggleHalfRightStyle" TargetType="Border">
            <Setter Property="Background" Value="#5C1414" />
            <Setter Property="CornerRadius" Value="0,8,8,0" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*" MinWidth="460" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.08*" MinWidth="500" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="WORK WITH TEXT" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                <Button Grid.Column="1" Style="{StaticResource DangerIconButtonStyle}" Margin="0"
                                        ToolTip="Clear message" Click="ClearMessageButton_Click">
                                    <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="13" Height="13" />
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Bold" Click="BoldButton_Click">
                                    <TextBlock Text="B" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Italic" Click="ItalicButton_Click">
                                    <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Code" Click="CodeButton_Click">
                                    <iconPacks:PackIconMaterial Kind="CodeTags" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Add link" Click="LinkButton_Click">
                                    <iconPacks:PackIconMaterial Kind="LinkVariant" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Forward" IsEnabled="False">
                                    <iconPacks:PackIconMaterial Kind="Repeat" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Attach file" IsEnabled="False">
                                    <iconPacks:PackIconMaterial Kind="Paperclip" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Bot button" IsEnabled="False">
                                    <iconPacks:PackIconMaterial Kind="RobotOutline" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Template" IsEnabled="False">
                                    <iconPacks:PackIconMaterial Kind="TextBoxMultiple" Width="15" Height="15" />
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="0"
                                        ToolTip="Insert first name" Click="PlaceholderButton_Click">
                                    <iconPacks:PackIconMaterial Kind="AccountOutline" Width="15" Height="15" />
                                </Button>
                            </StackPanel>

                            <TextBox x:Name="MessageTextBox" Height="150" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource MutedInputStyle}"
                                     TextChanged="MessageTextBox_TextChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SETTINGS" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                <Button Grid.Column="1" Style="{StaticResource CompactTextButtonStyle}" ToolTip="Reset settings" Click="ResetButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Reset" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#0C0C0E" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Use base data" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Request First name, Last name, Bio" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="SMS per account" Style="{StaticResource FieldLabelStyle}" />
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <TextBox x:Name="SmsMinTextBox" Height="44" Margin="0,0,12,0" Style="{StaticResource MutedInputStyle}" />
                                <TextBox x:Name="SmsMaxTextBox" Height="44" Style="{StaticResource MutedInputStyle}" />
                            </UniformGrid>

                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Delay" Style="{StaticResource FieldLabelStyle}" />
                                    <UniformGrid Columns="2">
                                        <TextBox x:Name="DelayMinTextBox" Height="44" Margin="0,0,8,0" Style="{StaticResource MutedInputStyle}" />
                                        <TextBox x:Name="DelayMaxTextBox" Height="44" Style="{StaticResource MutedInputStyle}" />
                                    </UniformGrid>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Maximum timeout (FloodWait)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="FloodWaitTextBox" Height="44" Style="{StaticResource MutedInputStyle}" />
                                </StackPanel>
                            </UniformGrid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Select Accounts" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="SelectedAccountsTextBox" Height="46" Style="{StaticResource MutedInputStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Height="46" VerticalAlignment="Bottom"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="SelectAccountsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="AccountOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Select Accounts" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Text="Delete dialog in account" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Preview links" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Silent mode" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Auto repost" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SENDING FILES" Style="{StaticResource SectionHeaderStyle}" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Send video in a circle (*.mp4)" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="File self-destruct in 60 seconds" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ADDITIONAL SETTINGS" Style="{StaticResource SectionHeaderStyle}" />
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Text="Sending by time" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="streams Control" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Auto stop" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Pin message in chat" Style="{StaticResource FieldLabelStyle}" />
                                    <Border Style="{StaticResource PlaceholderToggleStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource ToggleHalfLeftStyle}">
                                                <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource ToggleHalfRightStyle}">
                                                <iconPacks:PackIconMaterial Kind="CloseOctagon" Width="14" Height="14" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Background="{StaticResource AccentTintBrush}" BorderThickness="0">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="22"
                                   Text="When working by phone numbers, keep limits moderate. Telegram may report that a number has no user even when one exists; that usually means the account reached a limit. The sender account must be allowed to resolve and message the recipient." />
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="StartButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Start" VerticalAlignment="Center" />
                                <iconPacks:PackIconMaterial Kind="PlayCircleOutline" Width="15" Height="15" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="{tr:Tr Common.Stop}" Margin="10,0,0,0" Click="StopButton_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="MESSAGE VIEW" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="14" Height="186">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="PreviewTextBlock" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PhoneNumbersHeaderText" Grid.Column="0" Text="PHONE NUMBERS : 0"
                                           Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                <Button Grid.Column="1" Style="{StaticResource CompactTextButtonStyle}"
                                        ToolTip="Delete phone numbers" Click="ClearPhoneNumbersButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Delete" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#0C0C0E" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBox x:Name="PhoneNumbersTextBox" Height="254" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource MutedInputStyle}"
                                     TextChanged="PhoneNumbersTextBox_TextChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{tr:Tr Common.ResultsHeader}" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                <Button Grid.Column="1" Style="{StaticResource CompactTextButtonStyle}" ToolTip="{tr:Tr Common.Open}" Click="OpenResultsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{tr:Tr Common.Open}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#0C0C0E" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Height="104" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PROGRAM ACTIONS" Style="{StaticResource SectionHeaderStyle}" Margin="0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr Common.Start}" Click="StartButton_Click">
                                        <iconPacks:PackIconMaterial Kind="Play" Width="15" Height="15" />
                                    </Button>
                                    <Button Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="{tr:Tr Common.Stop}" Click="StopButton_Click">
                                        <iconPacks:PackIconMaterial Kind="Stop" Width="15" Height="15" />
                                    </Button>
                                    <Button Style="{StaticResource ToolbarIconButtonStyle}" Margin="0" ToolTip="{tr:Tr Common.ClearLog}" Click="ClearActionsButton_Click">
                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="15" Height="15" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="ProgramActionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      Height="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90" />
                                    <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="140" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
