<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file build for the Inno Setup installer
  (installer/TgPoolLauncher.iss). Bundles the .NET runtime so the target
  PC needs no separate .NET install, only Python for the backend.

  Build: dotnet publish -c Release -p:PublishProfile=win-x64
  Output: bin\Release\net10.0-windows\win-x64\publish\TgPoolLauncher.exe
-->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
